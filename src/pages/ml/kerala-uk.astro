.header{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}.logo{font:800 34px Oswald,Impact,sans-serif;white-space:nowrap}.logo span{color:var(--lime)}.logo small{font:800 13px 'DM Sans',sans-serif;letter-spacing:.08em}.header nav{display:flex;gap:24px}.header nav a{font-size:12px;font-weight:700}.language-select{display:flex;align-items:center;gap:8px;border:1px solid #739568;padding:5px}.language-select span,.language-select a{padding:8px 11px;font-size:11px;font-weight:800;white-space:nowrap}.language-select span{background:var(--lime);color:#20321a}.language-select a:hover{color:var(--lime)}
.hero{display:grid;grid-template-columns:1.18fr .82fr;gap:52px;align-items:center;padding:78px 0 92px}.hero h1{font-size:clamp(47px,4.8vw,75px);margin:23px 0}.lead{color:#d1e1c9;font-size:18px;line-height:2;max-width:700px}.meaning{padding:18px 20px;border-left:3px solid var(--lime);background:#253a24;margin:25px 0}.meaning strong{font:900 12px 'DM Sans',sans-serif;color:var(--lime);letter-spacing:.1em}.meaning p{font-size:13px;margin:7px 0 0;color:#d5e8cb}.actions{display:flex;flex-wrap:wrap;gap:10px;margin:23px 0}.primary,.secondary,.share,.dark-cta{display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;padding:13px 17px;line-height:1.7}.primary{background:var(--lime);color:#192815}.secondary{border:1px solid #83a47a;color:#e1f1d9}.share{border:1px dashed #6f8b66;color:var(--lime)}.pill-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}.pill-row span{border:1px solid #496245;padding:7px 10px;color:#c4d8ba;font-size:10px;font-weight:800}
.portrait{background:#f5f5f2;border:3px solid var(--lime);min-height:530px;position:relative;overflow:hidden}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center 28%;position:absolute;inset:0}.portrait-footer{position:absolute;bottom:0;left:0;right:0;background:#102215e6;display:flex;justify-content:space-between;gap:10px;align-items:center;padding:14px 17px}.portrait-footer strong,.portrait-footer span{font:900 11px 'DM Sans',sans-serif;letter-spacing:.08em}.portrait-footer span{color:var(--lime)}
.ribbon{background:var(--lime);color:#1a2915;display:flex;gap:18px;justify-content:space-around;align-items:center;padding:17px 20px;font-size:16px;font-weight:800}.ribbon b{font:900 18px 'DM Sans',sans-serif}.story,.credentials{display:grid;grid-template-columns:1fr 1fr;gap:8%;padding:95px 0}.story h2,.section-heading h2,.credentials h2,.closing h2{font-size:clamp(44px,4.5vw,65px);margin:18px 0}.story-copy p,.credentials p{color:#cbdcc2;line-height:2}.notice{padding:19px;border-left:3px solid var(--lime);background:#2b402b;margin-top:25px}.notice strong{color:var(--lime);font-size:13px}.notice p{margin:8px 0 0;font-size:12px}.credentials .fine{font-size:12px;color:#b6caaa;margin:12px 0 25px}.resources{background:#1c2d1c;padding:85px 0}.section-heading{display:flex;justify-content:space-between;gap:40px;align-items:end}.section-heading>p{max-width:385px;color:#c3d7b9;font-size:13px}.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:30px}.resource{border:1px solid #597b54;background:#293d29;padding:24px;display:flex;flex-direction:column;align-items:flex-start;min-height:235px}.resource:hover{border-color:var(--lime)}.resource-index{font:900 10px 'DM Sans',sans-serif;letter-spacing:.1em;color:var(--lime)}.resource h3{font-size:25px;margin:20px 0 13px}.resource p{font-size:13px;color:#c3d6bb;line-height:1.9}.resource-bottom{margin-top:auto;display:flex;justify-content:space-between;width:100%;border-top:1px solid #62845b;padding-top:11px;align-items:center}.resource-bottom small{color:#c0d5b7;font-size:10px}.resource-bottom strong{color:var(--lime);font-size:22px}
.closing{background:var(--lime);color:#182a13;padding:41px;display:flex;align-items:end;justify-content:space-between;gap:24px;margin:18px auto 76px}.closing h2{margin:20px 0}.closing h2 em{color:#faffea}.closing .eyebrow{color:#456429}.closing p:not(.eyebrow){font-size:13px}.dark-cta{background:#20361b;color:var(--lime);white-space:nowrap}.footer{border-top:1px solid #496343;display:flex;justify-content:space-between;gap:17px;align-items:center;padding:28px 0}.footer>a{font:900 20px Oswald,Impact,sans-serif}.footer p{font-size:11px;margin:0;color:#b5c6ac}.footer>div{display:flex;gap:14px}.footer>div a{font-size:11px}
