---
import { trainingProgrammes } from "../data/trainingProgrammes";

const links = [
  {number:'01',title:'Find my free plan',description:'Choose your experience and get a suitable starting-level example.',url:'#plan-finder',icon:'✳'},
  {number:'02',title:'Watch demonstrations',description:'Look up weights, cardio and HIIT movements.',url:'/app/workouts/',icon:'▶'},
  {number:'03',title:'Track a workout',description:'Use the free mobile app to log completed days on this device.',url:'/app/dashboard/#progress',icon:'◉'},
  {number:'04',title:'Meet the trainer',description:'Read Adeep’s experience and documented course history.',url:'/trainer/',icon:'↗'},
  {number:'05',title:'Digital member card demo',description:'Flip a fictional member card and view a private dashboard mockup.',url:'/app/membership/',icon:'▤'},
  {number:'06',title:'From Kerala to the UK',description:'The Malayali trainer behind the BF GYM Global learning platform.',url:'/kerala-uk/',icon:'✳'}
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content="#101310"/>
<meta name="description" content="Start free fitness learning with BF GYM Global. Check your adult BMI, choose a workout level and open a free four-week plan."/>
<title>Start Here — BF GYM Global</title>
<link rel="manifest" href="/manifest.webmanifest"/><link rel="icon" href="/bf-icon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet"/>
</head>
<body>
<a class="skip" href="#main">Skip to page</a>
<div class="shell">
<header class="header"><a href="/" class="logo">BF<span>.</span> GYM <small>GLOBAL</small></a><nav aria-label="Site navigation"><a href="/programmes/">FREE PLANS</a><a href="/app/workouts/">EXERCISES</a><a href="/trainer/">TRAINER</a><a href="/kerala-uk/">KERALA → UK</a></nav><a class="app-link" href="/app/">OPEN APP ↗</a></header>
<main id="main">
<section id="plan-finder" class="finder" aria-labelledby="finder-title">
<div class="finder-inner">
<div class="finder-copy">
  <h1 id="finder-title">Find your workout plan</h1>
  <p>Check your adult BMI and find a free workout plan that suits your training experience.</p>
  <p><a class="assessment-link" href="/programmes/">Browse all workout plans without entering details</a></p>
  <div class="finder-note">
    <p>This BMI check is for adults aged 18 and over. BMI is a rough measure and cannot distinguish muscle from fat. For eligibility and help interpreting your result, see the <a class="assessment-link" href="https://www.nhs.uk/health-assessment-tools/calculate-your-body-mass-index/calculate-bmi-for-adults">NHS adult BMI guide</a>.</p>
  </div>
</div>
<div class="finder-panel">
<noscript><p>Enable JavaScript to calculate BMI, or use the link above to browse the workout plans.</p></noscript>
<form id="level-form" hidden>
<fieldset aria-describedby="measurement-note">
  <legend>Your details</legend>
  <div class="measurement-grid">
    <label for="bmi-height">Height (cm)<input id="bmi-height" type="number" inputmode="decimal" min="0.1" step="any" required /></label>
    <label for="bmi-weight">Weight (kg)<input id="bmi-weight" type="number" inputmode="decimal" min="0.1" step="any" required /></label>
    <label for="bmi-age">Age (years)<input id="bmi-age" type="number" inputmode="numeric" min="18" step="1" required /></label>
    <label for="bmi-sex">Sex (optional)<select id="bmi-sex"><option value="">Prefer not to say</option><option value="female">Female</option><option value="male">Male</option><option value="other">Other</option></select></label>
  </div>
  <p id="measurement-note">Height and weight are used to calculate BMI. Your details stay on this page and are never saved or sent.</p>
</fieldset>
<fieldset><legend>How experienced are you with gym exercises?</legend>
<label class="choice"><input type="radio" name="experience" value="new" checked/><span><strong>Starting out</strong><small>New to training or restarting after a break</small></span></label>
<label class="choice"><input type="radio" name="experience" value="some"/><span><strong>Some experience</strong><small>Comfortable with a few regular gym exercises</small></span></label>
<label class="choice"><input type="radio" name="experience" value="regular"/><span><strong>Very experienced</strong><small>Confident training frequently with good technique</small></span></label>
</fieldset>
<fieldset><legend>How many days can you usually train?</legend>
<label class="choice"><input type="radio" name="days" value="few" checked/><span><strong>2–3 days a week</strong><small>Keep it flexible and simple</small></span></label>
<label class="choice"><input type="radio" name="days" value="many"/><span><strong>4 or more days a week</strong><small>Regular exercise fits my routine</small></span></label>
</fieldset>
<button type="submit" class="submit">Show my BMI and workout plan</button>
</form>
<div class="result" id="recommendation" hidden tabindex="-1" aria-labelledby="result-title">
<p class="bmi-reading">Your BMI <strong id="bmi-result"></strong> <span>kg/m²</span></p>
<p class="result-kicker">YOUR SUGGESTED STARTING POINT</p><h3 id="result-title">START STRONG</h3><p id="result-text"></p>
<div class="result-actions"><a id="result-link" class="primary" href="/programmes/?level=beginner#selected-plan">Open my free 4-week plan</a><a href="/sample-plan/">VIEW SAMPLE MEAL DAY ↗</a></div>
<p class="result-note">Your experience and training availability guide this suggestion. You can choose a different level below.</p>
<nav class="assessment-levels" aria-label="All workout levels">
  {trainingProgrammes.map(plan => <a href={`/programmes/?level=${plan.id}#selected-plan`}>{plan.level}</a>)}
</nav>
</div>
</div>
</div>
</section>
<section class="last-plan" aria-labelledby="last-title"><div><p class="eyebrow">03 / CONTINUE WHERE YOU STOPPED</p><h2 id="last-title">YOUR NEXT<br/><em>MOVE.</em></h2><p id="last-description">Already started one of our plans? The site can remember your last selected *level* on this device. Weekly completion ticks are managed on the programme page.</p></div><div class="last-actions"><a class="primary" id="continue-link" href="/programmes/">OPEN FREE PROGRAMMES ↗</a><a href="/app/workouts/">EXPLORE EXERCISES →</a></div></section>
<section class="shortcuts" aria-labelledby="shortcuts-title"><p class="eyebrow">01 / QUICK ACCESS</p><div class="section-head"><h2 id="shortcuts-title">WHERE DO YOU<br/><em>WANT TO GO?</em></h2><p>Everything important is within one tap. You can return here from the homepage or mobile app.</p></div>
<div class="shortcut-grid">{links.map(link=><a href={link.url} class="shortcut"><div class="shortcut-head"><span>{link.number} / BF GYM</span><span class="shortcut-icon" aria-hidden="true">{link.icon}</span></div><h3>{link.title}</h3><p>{link.description}</p><span class="shortcut-arrow">OPEN →</span></a>)}</div></section>
</main>
<footer class="footer"><a class="logo" href="/">BF<span>.</span> GYM <small>GLOBAL</small></a><p>Free educational workouts and examples · Paid bookings disabled</p><a href="/privacy/">PRIVACY</a></footer>
</div>
<script>
 const titles={
   beginner:{name:'Beginner · Start Strong',text:'The beginner plan focuses on simple strength movements, enjoyable low-impact cardio and manageable rest days. You can go at your own pace.'},
   intermediate:{name:'Intermediate · Build Momentum',text:'The intermediate plan introduces more gym exercises and regular cardio while keeping technique and recovery at the centre.'},
   advanced:{name:'Advanced · Strength & Conditioning',text:'The advanced example is for people already confident with frequent exercise, with training volume adjusted to the individual.'}
 };
 const key='bf-gym-last-plan-v1';
 function remember(level){
   try{localStorage.setItem(key,level);}catch{/* Private mode may block storage */}
 }
 function chooseLevel(experience,days){
   if(experience==='new')return 'beginner';
   if(experience==='regular' && days==='many')return 'advanced';
   return 'intermediate';
 }
 const form=document.querySelector<HTMLFormElement>('#level-form');
 const result=document.getElementById('recommendation');
 const height = document.querySelector<HTMLInputElement>('#bmi-height');
 const weight = document.querySelector<HTMLInputElement>('#bmi-weight');
 const bmiOutput = document.getElementById('bmi-result');
 if(form && result && height && weight && bmiOutput){
   form.hidden = false;
   form.addEventListener('input', () => { result.hidden = true; });
   height.addEventListener('input', () => height.setCustomValidity(''));
   weight.addEventListener('input', () => weight.setCustomValidity(''));
   form.addEventListener('submit',(event)=>{
     event.preventDefault();
     const heightMetres = height.valueAsNumber / 100;
     const bmi = weight.valueAsNumber / (heightMetres * heightMetres);
     if (!Number.isFinite(bmi) || bmi <= 0) {
       height.setCustomValidity('Enter your height in centimetres and check your weight in kilograms.');
       height.reportValidity();
       return;
     }
     bmiOutput.textContent = bmi.toFixed(1);
     const fd=new FormData(form);
     const experience=String(fd.get('experience')||'new');
     const days=String(fd.get('days')||'few');
     const level=chooseLevel(experience,days);
     remember(level);
     const title=document.getElementById('result-title');
     const description=document.getElementById('result-text');
     const link=document.getElementById('result-link');
     if(title)title.textContent=titles[level].name;
     if(description)description.textContent=titles[level].text;
     if(link)link.href='/programmes/?level='+level+'#selected-plan';
     result.hidden=false;
     result.focus();
     updateContinue(level);
   });
 }
 function updateContinue(level){
   const link=document.getElementById('continue-link');
   const description=document.getElementById('last-description');
   if(link){link.href='/programmes/?level='+level;link.textContent='CONTINUE '+titles[level].name+' ↗';}
   if(description)description.textContent='Your last chosen example level is '+titles[level].name+'. Open it to continue marking training days in the weekly tracker.';
 }
 try{
   const last=localStorage.getItem(key);
   if(last && Object.prototype.hasOwnProperty.call(titles,last))updateContinue(last);
 }catch{/* Storage unavailable */}
</script>
</body>
</html>
<style>
:root{--bg:#101310;--surface:#1d281c;--lime:#c7ff52;--text:#f1f4e9;--muted:#b9c8b0;--display:'Oswald',Impact,sans-serif;--body:'DM Sans',Arial,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:15px}body{background:var(--bg);color:var(--text);margin:0;font:14px/1.7 var(--body)}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--lime);outline-offset:3px}h1,h2,h3,p{margin-top:0}em{font-style:normal;color:var(--lime)}.shell{max-width:1240px;margin:auto;padding:0 24px}.skip{position:absolute;top:-100px;left:10px;padding:10px;background:var(--lime);color:#172412}.skip:focus{top:10px}
.header{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #3e5139;min-height:79px}.logo{font:800 28px var(--display)}.logo span{color:var(--lime)}.logo small{font:800 10px var(--body);letter-spacing:.15em}.header nav{display:flex;gap:24px}.header nav a,.app-link{font-size:10px;font-weight:800;letter-spacing:.09em}.app-link{border:1px solid var(--lime);padding:12px 16px}.header nav a:hover,.app-link:hover{color:var(--lime)}
.hero{padding:90px 0 65px;max-width:980px}.eyebrow{color:var(--lime);font-size:11px;font-weight:900;letter-spacing:.13em}.eyebrow span{font-size:9px;margin-right:7px}.hero h1{font:700 clamp(65px,9vw,125px)/1 var(--display);margin:25px 0}.hero>p:not(.eyebrow){font-size:16px;color:#c5d4be;max-width:730px;line-height:1.85}.primary,.submit{display:inline-flex;justify-content:space-between;align-items:center;gap:22px;padding:17px 20px;background:var(--lime);color:#162611;border:none;font-size:11px;font-weight:900;letter-spacing:.04em}.hero .primary{margin-top:22px}.primary span{font-size:16px}
.trust{display:flex;flex-wrap:wrap;justify-content:space-between;gap:17px;background:var(--lime);color:#192914;font-size:11px;font-weight:900;letter-spacing:.07em;padding:15px 24px}
.shortcuts{padding:95px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px}.section-head h2,.finder h2,.last-plan h2{font:700 clamp(48px,6vw,78px)/1 var(--display);margin:15px 0 26px}.section-head>p{max-width:335px;color:var(--muted);font-size:13px}.shortcut-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-top:25px}.shortcut{display:flex;flex-direction:column;gap:18px;min-height:245px;padding:19px;background:#233221;border:1px solid #5b754e;transition:transform .2s,border-color .2s}.shortcut:hover{transform:translateY(-3px);border-color:var(--lime)}.shortcut-head{display:flex;align-items:center;justify-content:space-between;color:var(--lime);font-size:9px;font-weight:900;letter-spacing:.1em}.shortcut-icon{font-size:24px}.shortcut h3{font:650 27px/1.1 var(--display);text-transform:uppercase}.shortcut p{font-size:12px;color:#c8d8c1;line-height:1.75}.shortcut-arrow{margin-top:auto;color:var(--lime);font-weight:900;font-size:10px}
.finder{background:#1b291a;padding:90px 24px}.finder-inner{max-width:1192px;margin:auto;display:grid;grid-template-columns:.85fr 1.15fr;gap:55px;align-items:start}.finder-copy>p:not(.eyebrow){font-size:14px;color:#c7d7c1;line-height:1.85}.finder-note{margin-top:34px;padding:20px;border-left:3px solid var(--lime);background:#263b25}.finder-note strong{font-size:11px;color:var(--lime)}.finder-note p{font-size:12px;color:#c5d8ba;line-height:1.8;margin:7px 0 0}
.finder-panel{padding:28px;background:#293d28;border:1px solid #648358}.finder-panel fieldset{border:0;margin:0 0 28px;padding:0}.finder-panel legend{font-size:15px;font-weight:800;margin-bottom:15px}.finder-panel legend span{display:block;color:var(--lime);font-size:10px;letter-spacing:.14em;margin-bottom:6px}.choice{position:relative;display:flex;align-items:center;gap:14px;background:#1a2c1a;border:1px solid #526c4c;cursor:pointer;padding:12px 15px;margin:8px 0}.choice:has(input:checked){background:#374f30;border-color:var(--lime)}.choice input{accent-color:var(--lime);width:20px;height:20px;flex-shrink:0}.choice strong{font-size:13px;display:block}.choice small{font-size:11px;color:#bbccb4;display:block;margin-top:3px}.submit{width:100%}
.result{background:#d6ff8a;color:#172512;padding:25px;margin-top:25px;outline-offset:4px}.result-kicker{font-size:10px;letter-spacing:.12em;font-weight:900}.result h3{font:700 39px/1 var(--display);margin:14px 0}.result>p:not(.result-kicker){font-size:12px;line-height:1.8}.result-actions{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:18px 0}.result-actions .primary{background:#192a17;color:#d8ffa3}.result-actions>a:last-child{font-size:10px;font-weight:900;text-decoration:underline}.result-note{font-size:10px!important;color:#52663f}
.last-plan{padding:85px 25px;margin:75px 0;background:#253923;display:flex;justify-content:space-between;align-items:end;gap:45px}.last-plan>div:first-child{max-width:600px}.last-plan>div:first-child>p:not(.eyebrow){color:#c8d5c0}.last-actions{display:flex;flex-direction:column;gap:18px;align-items:flex-start;min-width:265px}.last-actions>a:last-child{font-size:11px;font-weight:900;border-bottom:1px solid #9db98a;padding-bottom:8px}
.footer{display:flex;align-items:center;justify-content:space-between;gap:15px;border-top:1px solid #43543d;padding:26px 0}.footer p{font-size:11px;color:var(--muted);margin:0}.footer>a:last-child{font-size:10px}
@media(max-width:1000px){.shortcut-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.finder-inner{grid-template-columns:1fr;gap:30px}.finder-copy h2{margin-bottom:20px}}
@media(max-width:680px){.shell{padding:0 16px}.header{min-height:68px}.header nav{display:none}.logo{font-size:24px}.logo small{font-size:9px}.app-link{padding:10px;font-size:9px}.hero{padding:62px 0 45px}.hero h1{font-size:clamp(59px,11vw,82px)}.trust{gap:10px;padding:14px 16px;font-size:9px}.shortcuts{padding:60px 0}.section-head{display:block}.shortcut-grid{gap:9px}.shortcut{padding:15px;min-height:235px}.shortcut h3{font-size:24px}.shortcut p{font-size:11px}.finder{padding:60px 16px}.finder-panel{padding:17px}.finder h2,.section-head h2,.last-plan h2{font-size:54px}.last-plan{padding:30px 20px;display:block;margin:40px 0}.last-actions{min-width:0;margin-top:26px}.footer{flex-wrap:wrap}}
@media(max-width:440px){.shortcut-grid{grid-template-columns:1fr}.shortcut{min-height:180px}.trust{font-size:8px}.hero h1{font-size:57px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.shortcut{transition:none}}
#plan-finder{margin-top:1.5rem}
.finder-copy h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.06;margin:0 0 1rem;text-transform:none}
.finder-copy p,.finder-note p,#measurement-note{font-size:1rem}
.assessment-link,.assessment-levels a{text-decoration:underline;text-underline-offset:.2em}
#level-form[hidden],#recommendation[hidden]{display:none}
.measurement-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
.measurement-grid label{display:grid;gap:.35rem;font-size:1rem}
.measurement-grid input,.measurement-grid select{font:inherit;width:100%;min-width:0;min-height:44px;border:1px solid #71856a;border-radius:.4rem;background:#161f16;color:#f4f7ef;padding:.5rem}
.bmi-reading{font-size:1.1rem}
.bmi-reading strong{font-size:1.5rem}
.assessment-levels{display:flex;gap:.75rem;flex-wrap:wrap}
.assessment-levels a{font-size:1rem;padding:.65rem 0}
@media(max-width:390px){.measurement-grid{grid-template-columns:1fr}}
</style>