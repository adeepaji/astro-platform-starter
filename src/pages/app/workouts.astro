---
import { workoutVideos } from '../../data/workoutVideos';
import { exerciseQueries } from '../../data/exerciseQueries';
const catalogueCounts = {
  all: exerciseQueries.length,
  strength: exerciseQueries.filter(e=>e.category==='strength').length,
  cardio: exerciseQueries.filter(e=>e.category==='cardio').length,
  hiit: exerciseQueries.filter(e=>e.category==='hiit').length,
};
const groupedExercises = {
  strength: exerciseQueries.filter(e=>e.category==='strength'),
  cardio: exerciseQueries.filter(e=>e.category==='cardio'),
  hiit: exerciseQueries.filter(e=>e.category==='hiit'),
};
const exerciseDirectory = Array.from({length:Math.max(groupedExercises.strength.length,groupedExercises.cardio.length,groupedExercises.hiit.length)},(_,i)=>
  [groupedExercises.strength[i],groupedExercises.cardio[i],groupedExercises.hiit[i]]
).flat().filter((entry)=>entry!==undefined);
const focusOptions = [...new Set(exerciseQueries.map(e=>e.focus))].sort();
const equipmentOptions = [...new Set(exerciseQueries.map(e=>e.equipment))].sort();
const youtubeQueryUrl = (name:string) => 'https://www.youtube.com/results?search_query='+encodeURIComponent(name+' exercise demonstration proper form');
const totals = {
  all: workoutVideos.length,
  strength: workoutVideos.filter(w=>w.category==='strength').length,
  cardio: workoutVideos.filter(w=>w.category==='cardio').length,
  hiit: workoutVideos.filter(w=>w.category==='hiit').length,
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#101310" />
  <meta name="description" content="BF GYM exercise video library: strength training, weight lifting, cardio and HIIT demo videos from YouTube, with search and difficulty filters." />
  <title>Workout Video Library | BF GYM</title>
  <link rel="icon" href="/bf-icon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/app-icon-192.png" />
</head>
<body>
  <div class="shell">
    <header class="header">
      <a href="/app/" class="logo" aria-label="Back to BF GYM app"><span>BF<b>.</b></span><strong>GYM</strong></a>
      <a class="return" href="/app/"><span aria-hidden="true">←</span> FITNESS APP</a>
    </header>
    <main>
      <section class="hero">
        <p class="kicker"><span class="signal"></span> BF GYM / TRAINING EDUCATION</p>
        <h1>LEARN THE<br /><em>MOVEMENT.</em><br />OWN THE REP.</h1>
        <p>Explore selected YouTube demonstrations plus a searchable directory of 418 common exercises. Find strength, weight training, cardio and HIIT videos without leaving a movement out of your search.</p>
        <div class="hero-nums">
          <div><strong>{totals.all}</strong><span>CURATED VIDEOS</span></div>
          <div><strong>{catalogueCounts.all}</strong><span>EXERCISE SEARCHES</span></div>
          <div><strong>FREE</strong><span>TO WATCH</span></div>
        </div>
      </section>
      <section class="library" aria-labelledby="library-heading">
        <div class="section-title"><div><p class="kicker">01 / VIDEO LIBRARY</p><h2 id="library-heading">FIND YOUR <em>EXERCISE.</em></h2></div><a href="/book/" class="mini-book">NEED A COACH? ↗</a></div>
        <div class="search-wrap">
          <label for="search-exercises">SEARCH DEMONSTRATIONS</label>
          <div class="search-box"><span aria-hidden="true">⌕</span><input type="search" id="search-exercises" placeholder="Try bench press, treadmill, burpees..." autocomplete="off" maxlength="80" /></div>
        </div>
        <div class="filters" role="group" aria-label="Filter workout type">
          <button class="filter active" type="button" data-category-filter="all" aria-pressed="true">All <span>{totals.all}</span></button>
          <button class="filter" type="button" data-category-filter="strength" aria-pressed="false">Weights <span>{totals.strength}</span></button>
          <button class="filter" type="button" data-category-filter="cardio" aria-pressed="false">Cardio <span>{totals.cardio}</span></button>
          <button class="filter" type="button" data-category-filter="hiit" aria-pressed="false">HIIT <span>{totals.hiit}</span></button>
          <button class="filter" type="button" data-category-filter="saved" aria-pressed="false">Saved <span id="saved-count">0</span></button>
        </div>
        <div class="secondary-filters">
          <label for="level-filter">Difficulty <select id="level-filter"><option value="all">All levels</option><option value="Beginner">Beginner</option><option value="Intermediate">Intermediate</option><option value="Advanced">Advanced</option></select></label>
          <label for="equipment-filter">Equipment <select id="equipment-filter"><option value="all">All equipment</option><option value="Bodyweight">Bodyweight</option><option value="Dumbbells">Dumbbells</option><option value="Barbell">Barbell</option><option value="Resistance band">Resistance band</option><option value="Gym machine">Gym machine</option><option value="Cardio machine">Cardio machine</option></select></label>
        </div>
        <div class="results-head"><p id="results-count" role="status" aria-live="polite">Showing {totals.all} videos</p><button type="button" id="clear-filters">RESET FILTERS ↺</button></div>
        <div class="video-grid" id="video-grid">
          {workoutVideos.map((video) => (
            <article class="video-card" data-category={video.category} data-level={video.level} data-equipment={video.equipment} data-id={video.id} data-search={[video.name,video.category,video.level,video.equipment,video.focus,video.creator].join(' ').toLowerCase()}>
              <div class="thumb">
                <img src={'https://i.ytimg.com/vi/'+video.youtubeId+'/mqdefault.jpg'} alt={'Video preview for '+video.name} width="320" height="180" loading="lazy" decoding="async" />
                <button type="button" class="play" data-video-id={video.youtubeId} data-video-title={video.name} aria-label={'Play '+video.name+' demonstration'}><span aria-hidden="true">▶</span><span>WATCH DEMO</span></button>
                <span class="type-chip">{video.category === 'strength' ? 'STRENGTH' : video.category.toUpperCase()}</span>
              </div>
              <div class="video-content">
                <div class="meta"><span>{video.level}</span><span>{video.equipment}</span></div>
                <h3>{video.name}</h3>
                <p class="creator">BY {video.creator}</p>
                <p class="tip"><strong>FORM TIP</strong> {video.tip}</p>
                <div class="actions">
                  <a href={'https://www.youtube.com/watch?v='+video.youtubeId} target="_blank" rel="noopener noreferrer" aria-label={'Open '+video.name+' on YouTube'}>OPEN YOUTUBE ↗</a>
                  <button type="button" class="save" data-save-id={video.id} aria-label={'Save '+video.name+' to favourites'} aria-pressed="false">☆ <span>SAVE</span></button>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="empty" id="empty-state" hidden><strong>NO MATCHING DEMOS</strong><p>Try a different training type, difficulty or search term.</p><button type="button" id="empty-reset">SHOW ALL VIDEOS</button></div>
        
        <section class="exercise-directory" id="exercise-directory" aria-labelledby="directory-heading">
          <div class="dir-heading"><div><p class="kicker">02 / EXPLORE ALL EXERCISES</p><h2 id="directory-heading">EVERY MUSCLE.<br/><em>MORE MOVEMENTS.</em></h2><p>Browse {catalogueCounts.all} exercise names. Each link opens the latest matching demonstration results on YouTube, so you can explore different instructors and variations. These are searches, not individually checked or hosted videos.</p></div><div class="dir-total"><strong>{catalogueCounts.all}</strong><span>EXERCISES</span></div></div>
          <div class="dir-search">
            <label for="directory-search">FIND AN EXERCISE</label>
            <div class="search-box"><span aria-hidden="true">⌕</span><input id="directory-search" type="search" placeholder="e.g. biceps curl, deadlift, rowing..." maxlength="100" autocomplete="off" /></div>
          </div>
          <div class="dir-tabs" role="group" aria-label="Exercise categories">
            <button type="button" class="dir-tab selected" data-dir-category="all" aria-pressed="true">All <span>{catalogueCounts.all}</span></button>
            <button type="button" class="dir-tab" data-dir-category="strength" aria-pressed="false">Weight training <span>{catalogueCounts.strength}</span></button>
            <button type="button" class="dir-tab" data-dir-category="cardio" aria-pressed="false">Cardio <span>{catalogueCounts.cardio}</span></button>
            <button type="button" class="dir-tab" data-dir-category="hiit" aria-pressed="false">HIIT <span>{catalogueCounts.hiit}</span></button>
          </div>
          <div class="dir-selects">
            <label for="directory-focus">Muscle / workout type
              <select id="directory-focus"><option value="all">All areas</option>{focusOptions.map(focus=><option value={focus}>{focus}</option>)}</select>
            </label>
            <label for="directory-equipment">Equipment
              <select id="directory-equipment"><option value="all">Any equipment</option>{equipmentOptions.map(equipment=><option value={equipment}>{equipment}</option>)}</select>
            </label>
            <label for="directory-level">Level
              <select id="directory-level"><option value="all">All levels</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select>
            </label>
          </div>
          <div class="dir-toolbar"><p id="dir-count" role="status" aria-live="polite">Showing 24 of {catalogueCounts.all} exercises</p><button type="button" id="dir-reset">CLEAR FILTERS ↺</button></div>
          <div class="exercise-grid">
            {exerciseDirectory.map((exercise,index)=><article class="exercise-card" hidden={index>=24}
                data-dir-category={exercise.category} data-dir-focus={exercise.focus} data-dir-equipment={exercise.equipment} data-dir-level={exercise.level} data-dir-search={(exercise.name+' '+exercise.focus+' '+exercise.equipment+' '+exercise.level).toLowerCase()}>
              <div class="exercise-meta"><span>{exercise.category==='strength'?'WEIGHTS / STRENGTH':exercise.category.toUpperCase()}</span><span>{exercise.level}</span></div>
              <h3>{exercise.name}</h3>
              <p>{exercise.focus} · {exercise.equipment}</p>
              <a href={youtubeQueryUrl(exercise.name)} target="_blank" rel="noopener noreferrer" aria-label={'Find '+exercise.name+' demonstrations on YouTube'}>FIND YOUTUBE DEMOS <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>
          <p class="dir-empty" id="dir-empty" hidden>No matching exercise was found. Try a simpler name, or search YouTube for any movement below.</p>
          <button class="dir-showmore" type="button" id="dir-showmore">LOAD MORE EXERCISES <span aria-hidden="true">↓</span></button>
          <div class="dir-any">
            <div><strong>CAN'T FIND YOUR EXERCISE?</strong><p>Type any other exercise, workout, machine, movement or instructor. Open YouTube's live search to see available demonstrations.</p></div>
            <a id="dir-any-link" href="https://www.youtube.com/results?search_query=exercise+demonstration" target="_blank" rel="noopener noreferrer">SEARCH ALL YOUTUBE ↗</a>
          </div>
        </section>
<div class="more-videos">
          <p class="kicker">KEEP EXPLORING</p>
          <h3>LOOKING FOR A DIFFERENT EXERCISE?</h3>
          <p>Our curated collection covers popular movements, not every exercise ever created. Search YouTube directly for additional demonstrations, or ask about personalised training.</p>
          <div><a id="youtube-more" href="https://www.youtube.com/results?search_query=exercise+demonstration" target="_blank" rel="noopener noreferrer">FIND MORE ON YOUTUBE ↗</a><a href="/book/">ASK BF GYM ABOUT COACHING ↗</a></div>
        </div>
      </section>
      <section class="safety">
        <p class="kicker">03 / TRAIN SMART</p>
        <h2>FORM FIRST.<br /><em>EGO LAST.</em></h2>
        <p>These third-party videos are for general fitness education. They are not personalised medical or training advice. Start at a manageable level, warm up, check equipment and stop if you experience pain, dizziness or unusual symptoms. Ask a qualified professional before attempting exercises that may be unsuitable for you.</p>
        <p class="rights">Videos and thumbnail images remain hosted by YouTube and belong to their respective creators. The library provides links and optional standard YouTube embeds; BF GYM does not claim ownership or download and re-host their content. Videos may be removed, restricted or unavailable for embedded playback.</p>
      </section>
    </main>
    <footer><a href="/app/">BF<b>.</b> GYM FITNESS APP</a><div><a href="/">WEBSITE</a><a href="/privacy/">PRIVACY</a></div></footer>
  </div>
  <dialog class="player-dialog" id="player-dialog" aria-labelledby="player-title">
    <div class="player-head"><div><small>BF GYM / YOUTUBE DEMONSTRATION</small><h2 id="player-title">VIDEO DEMO</h2></div><button type="button" id="close-player" aria-label="Close video">✕</button></div>
    <div class="frame-container"><iframe id="youtube-frame" title="YouTube workout demonstration" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
    <div class="player-bottom"><p>Video provided by the original YouTube creator. If playback is blocked, open the video directly.</p><a id="external-video" href="https://www.youtube.com" target="_blank" rel="noopener noreferrer">WATCH ON YOUTUBE ↗</a></div>
  </dialog>
  <nav class="mobile-nav" aria-label="Mobile navigation"><a href="/app/"><span>⌂</span>Home</a><a href="/app/workouts/" aria-current="page"><span>▶</span>Videos</a><a href="/app/#progress"><span>◉</span>Progress</a><a href="/book/"><span>↗</span>Book</a></nav>
  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.video-card'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
    const searchInput = document.querySelector<HTMLInputElement>('#search-exercises');
    const levelSelect = document.querySelector<HTMLSelectElement>('#level-filter');
    const equipmentSelect = document.querySelector<HTMLSelectElement>('#equipment-filter');
    const countText = document.querySelector<HTMLElement>('#results-count');
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const savedCount = document.querySelector<HTMLElement>('#saved-count');
    const youtubeMore = document.querySelector<HTMLAnchorElement>('#youtube-more');
    const storageKey = 'bf-gym-video-favourites-v1';
    const allIds = new Set(cards.map(card => card.dataset.id || ''));
    let favourites = new Set<string>();
    try {
      const raw = JSON.parse(localStorage.getItem(storageKey) || '[]');
      if (Array.isArray(raw)) favourites = new Set(raw.filter((x:unknown):x is string => typeof x === 'string' && allIds.has(x)));
    } catch { favourites = new Set(); }
    let category='all';
    function update() {
      const needle = (searchInput?.value || '').trim().toLowerCase();
      const level = levelSelect?.value || 'all';
      const equipment = equipmentSelect?.value || 'all';
      let visible=0;
      for (const card of cards) {
        const show = (category==='all' || (category==='saved' ? favourites.has(card.dataset.id||'') : card.dataset.category===category))
          && (level==='all' || card.dataset.level===level)
          && (equipment==='all' || card.dataset.equipment===equipment)
          && (!needle || (card.dataset.search||'').includes(needle));
        card.hidden=!show;
        if(show) visible++;
        const save = card.querySelector<HTMLButtonElement>('.save');
        const isSaved=favourites.has(card.dataset.id||'');
        if(save) {
          save.setAttribute('aria-pressed',String(isSaved));
          save.setAttribute('aria-label',(isSaved?'Remove ':'Save ') + (card.querySelector('h3')?.textContent || 'exercise') + (isSaved?' from favourites':' to favourites'));
          save.innerHTML=isSaved?'★ <span>SAVED</span>':'☆ <span>SAVE</span>';
        }
      }
      if(countText) countText.textContent='Showing '+visible+' of '+cards.length+' videos';
      if(savedCount) savedCount.textContent=String(favourites.size);
      if(empty) empty.hidden=visible!==0;
      if(youtubeMore){
        const query=needle ? needle+' exercise demonstration' : 'exercise demonstration cardio strength HIIT';
        youtubeMore.href='https://www.youtube.com/results?search_query='+encodeURIComponent(query);
      }
    }
    filterButtons.forEach(button=>button.addEventListener('click',()=>{
      category=button.dataset.categoryFilter||'all';
      filterButtons.forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});
      update();
    }));
    searchInput?.addEventListener('input',update);
    levelSelect?.addEventListener('change',update);
    equipmentSelect?.addEventListener('change',update);
    function resetFilters(){
      category='all';
      if(searchInput)searchInput.value='';
      if(levelSelect)levelSelect.value='all';
      if(equipmentSelect)equipmentSelect.value='all';
      filterButtons.forEach(b=>{const active=b.dataset.categoryFilter==='all';b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});
      update();
    }
    document.querySelector('#clear-filters')?.addEventListener('click',resetFilters);
    document.querySelector('#empty-reset')?.addEventListener('click',resetFilters);
    document.querySelectorAll<HTMLButtonElement>('[data-save-id]').forEach(button=>button.addEventListener('click',()=>{
      const id=button.dataset.saveId;
      if(!id || !allIds.has(id))return;
      if(favourites.has(id))favourites.delete(id);else favourites.add(id);
      try{localStorage.setItem(storageKey,JSON.stringify([...favourites]));}catch {}
      update();
    }));
    const dialog=document.querySelector<HTMLDialogElement>('#player-dialog');
    const frame=document.querySelector<HTMLIFrameElement>('#youtube-frame');
    const playerTitle=document.querySelector<HTMLElement>('#player-title');
    const external=document.querySelector<HTMLAnchorElement>('#external-video');
    document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach(button=>button.addEventListener('click',()=>{
      const id=button.dataset.videoId;
      if(!id || !/^[A-Za-z0-9_-]{11}$/.test(id) || !dialog || !frame)return;
      if(playerTitle)playerTitle.textContent=button.dataset.videoTitle||'VIDEO DEMO';
      if(external)external.href='https://www.youtube.com/watch?v='+id;
      frame.src='https://www.youtube-nocookie.com/embed/'+id+'?rel=0';
      dialog.showModal();
    }));
    document.querySelector('#close-player')?.addEventListener('click',()=>dialog?.close());
    dialog?.addEventListener('click',(event)=>{
      if(event.target===dialog) dialog.close();
    });
    dialog?.addEventListener('close',()=>{if(frame)frame.src='about:blank';});
    if('serviceWorker' in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));

    // Searchable exercise directory: external YouTube search, not automatic hosting or scraping.
    const dirCards = Array.from(document.querySelectorAll<HTMLElement>('.exercise-card'));
    const dirTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-dir-category]'));
    const dirSearch = document.querySelector<HTMLInputElement>('#directory-search');
    const dirFocus = document.querySelector<HTMLSelectElement>('#directory-focus');
    const dirEquipment = document.querySelector<HTMLSelectElement>('#directory-equipment');
    const dirLevel = document.querySelector<HTMLSelectElement>('#directory-level');
    const dirCount = document.querySelector<HTMLElement>('#dir-count');
    const dirEmpty = document.querySelector<HTMLElement>('#dir-empty');
    const dirMore = document.querySelector<HTMLButtonElement>('#dir-showmore');
    const dirAny = document.querySelector<HTMLAnchorElement>('#dir-any-link');
    let dirCategory = 'all';
    let dirLimit = 24;
    const renderDirectory = () => {
      const needle = (dirSearch?.value || '').toLowerCase().trim();
      const focus = dirFocus?.value || 'all';
      const equipment = dirEquipment?.value || 'all';
      const level = dirLevel?.value || 'all';
      let matching=0;
      let shown=0;
      for (const card of dirCards) {
        const match = (dirCategory==='all'||card.dataset.dirCategory===dirCategory) &&
          (focus==='all'||card.dataset.dirFocus===focus) &&
          (equipment==='all'||card.dataset.dirEquipment===equipment) &&
          (level==='all'||card.dataset.dirLevel===level) &&
          (!needle||(card.dataset.dirSearch||'').includes(needle));
        if(match) matching++;
        if(match && shown<dirLimit){shown++;card.hidden=false;}else card.hidden=true;
      }
      if(dirCount) dirCount.textContent='Showing '+shown+' of '+matching+' matching exercises';
      if(dirMore) dirMore.hidden=shown>=matching;
      if(dirEmpty) dirEmpty.hidden=matching!==0;
      if(dirAny){
        const search = needle || 'exercise demonstration';
        dirAny.href='https://www.youtube.com/results?search_query='+encodeURIComponent(search+' exercise demonstration');
      }
    };
    const updateDirFilter = () => {dirLimit=24;renderDirectory();};
    dirTabs.forEach(button=>button.addEventListener('click',()=>{
      dirCategory=button.dataset.dirCategory||'all';
      for(const tab of dirTabs){
        const active=tab===button;
        tab.classList.toggle('selected',active);
        tab.setAttribute('aria-pressed',String(active));
      }
      updateDirFilter();
    }));
    dirSearch?.addEventListener('input',updateDirFilter);
    dirFocus?.addEventListener('change',updateDirFilter);
    dirEquipment?.addEventListener('change',updateDirFilter);
    dirLevel?.addEventListener('change',updateDirFilter);
    dirMore?.addEventListener('click',()=>{dirLimit+=24;renderDirectory();});
    document.querySelector('#dir-reset')?.addEventListener('click',()=>{
      dirCategory='all';dirLimit=24;
      if(dirSearch)dirSearch.value='';
      if(dirFocus)dirFocus.value='all';
      if(dirEquipment)dirEquipment.value='all';
      if(dirLevel)dirLevel.value='all';
      dirTabs.forEach(button=>{
        const active=button.dataset.dirCategory==='all';
        button.classList.toggle('selected',active);
        button.setAttribute('aria-pressed',String(active));
      });
      renderDirectory();
    });
    renderDirectory();
    update();
  </script>
</body>
</html>
<style is:global>
:root{--bg:#101310;--surface:#1d241c;--green:#c7ff52;--text:#f1f4eb;--muted:#abb9a6;--border:#344331;--font:Impact,'Arial Narrow',sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;padding-bottom:77px}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--green);outline-offset:3px}em,b{color:var(--green);font-style:normal}.shell{width:min(1120px,calc(100% - 34px));margin:auto}.header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px 0;border-bottom:1px solid var(--border)}.logo{display:flex;align-items:center;gap:8px}.logo>span{font:800 36px/1 var(--font);letter-spacing:-.055em}.logo strong{letter-spacing:.13em;font-size:13px}.return{font-weight:800;font-size:11px;color:#b8cbb3;letter-spacing:.08em}.return span{font-size:20px;color:var(--green);vertical-align:middle;margin-right:8px}
.kicker{color:var(--green);font-size:10px;font-weight:900;letter-spacing:.15em}.signal{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:9px}.hero{position:relative;overflow:hidden;padding:65px 25px 0;min-height:450px;background:radial-gradient(ellipse at right,#304222 0%,#121b12 58%,transparent 85%);border-bottom:1px solid var(--border)}.hero:after{content:"";width:280px;height:280px;border:1px solid #bedf7166;border-radius:50%;position:absolute;right:-155px;top:30px;box-shadow:0 0 0 50px #c7ff5207,0 0 0 100px #c7ff5204;pointer-events:none}h1,h2,.more-videos h3,.empty strong{font-family:var(--font);line-height:1;letter-spacing:-.01em}.hero h1{font-size:clamp(65px,9vw,108px);margin:24px 0;position:relative;z-index:1}.hero>p:not(.kicker){color:#bfceba;font-size:15px;line-height:1.8;max-width:590px;position:relative;z-index:1}.hero-nums{display:flex;gap:42px;padding:30px 0 24px;margin-top:40px;border-top:1px solid #485742;position:relative;z-index:1}.hero-nums>div{display:grid;gap:1px}.hero-nums strong{font:800 27px var(--font);color:var(--green)}.hero-nums span{font-size:9px;letter-spacing:.08em;color:#c1d0bc;font-weight:700}
.library{padding:73px 10px}.section-title{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:35px}.section-title h2,.safety h2{font-size:clamp(42px,5vw,69px);margin:14px 0 0}.mini-book{white-space:nowrap;border:1px solid #748c60;padding:13px 15px;color:var(--green);font-size:10px;font-weight:900}
