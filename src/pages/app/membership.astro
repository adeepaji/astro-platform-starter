---
const demo = {
  name: 'ARUN NAIR',
  id: 'BF-DEMO-0001',
  type: 'FITNESS MEMBER',
  height: '175 cm',
  weight: '78.0 kg',
  bmi: '25.5',
  sessions: '4 / 5',
};
const features = [
  {step:'01',name:'REGISTER SECURELY',copy:'Future members would create an account, review a privacy notice and consent where required. Registration is not available in this demo.'},
  {step:'02',name:'RECEIVE A MEMBER PASS',copy:'A future system could issue a revocable membership ID with a protected verification token, not a public link to health details.'},
  {step:'03',name:'OPEN A PRIVATE DASHBOARD',copy:'Height, weight, BMI and workout progress would stay behind authentication, with appropriate access controls.'},
  {step:'04',name:'ADD TO PHONE WALLET',copy:'Apple Wallet and Google Wallet passes would require separate approved issuer setup and secure production infrastructure.'},
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content="#101810"/>
<meta name="description" content="Explore the BF GYM Global digital membership card prototype, created by UK-based Malayali fitness coach Adeep Aji, originally from Kerala. Fictional member, flip card, QR placeholder and private fitness dashboard mockup. No registration or payments."/>
<meta property="og:type" content="website"/>
<meta property="og:title" content="BF GYM Global | Digital Fitness Member Card — Concept"/>
<meta property="og:description" content="A digital fitness card concept from a Malayali-led, UK-based fitness learning platform. Explore a fictional card, no live sign-ups or payments."/>
<meta property="og:url" content="https://bfgym.netlify.app/app/membership/"/>
<meta name="robots" content="index,follow"/>
<link rel="canonical" href="https://bfgym.netlify.app/app/membership/"/>
<title>BF GYM Member Card Demo | Kerala to UK Fitness Community</title>
<link rel="icon" href="/bf-icon.svg" type="image/svg+xml"/>
<link rel="manifest" href="/manifest.webmanifest"/>
<link rel="apple-touch-icon" href="/app-icon-192.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet"/>
</head>
<body>
<a href="#main" class="skip">Skip to content</a>
<div class="site">
<header class="topbar wrap">
  <a class="brand" href="/" aria-label="BF GYM Global home">BF<span>.</span><strong>GYM <small>GLOBAL</small></strong></a>
  <nav aria-label="Site navigation"><a href="/kerala-uk/">KERALA → UK STORY</a><a href="/trainer/">COACH ADEEP</a><a href="/programmes/">FREE PLANS</a></nav>
  <a class="nav-cta" href="/app/dashboard/">FREE FITNESS APP ↗</a>
</header>
<main id="main">
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="eyebrow"><span class="live-dot" aria-hidden="true"></span> BF GYM GLOBAL / DIGITAL MEMBERSHIP DESIGN</div>
    <h1 id="hero-heading">YOUR FITNESS.<br/><em>YOUR IDENTITY.</em></h1>
    <p class="hero-lede">Meet the BF GYM member card concept — an ATM-style fitness identity card with a front, back and a separate private wellness dashboard. Made to feel personal without exposing health information in a QR scan.</p>
    <div class="demo-status"><strong>CONCEPT PREVIEW</strong><span>Fictional member · No real account · No usable QR · No Wallet pass · No payment card</span></div>
  </section>
  <section class="preview-section" id="card-demo" aria-labelledby="card-title">
    <div class="wrap preview-grid">
      <div class="preview-copy">
        <p class="eyebrow">01 / THE MEMBER CARD</p>
        <h2 id="card-title">A CARD THAT<br/><em>FEELS YOURS.</em></h2>
        <p>Inspired by the familiar size and feel of a bank card, but designed strictly as a <strong>fitness membership pass</strong>. No financial functionality or identity verification exists in this preview.</p>
        <div class="example-tag"><span class="fake-dot" aria-hidden="true"></span> SAMPLE MEMBER — NOT A REAL CLIENT</div>
        <div class="card-controls">
          <button id="flip-card" type="button" class="primary-btn" aria-controls="card-scene" aria-pressed="false">FLIP TO CARD BACK <span aria-hidden="true">↻</span></button>
          <button id="reset-card" type="button" class="ghost-btn">SHOW FRONT</button>
        </div>
        <p class="device-note" id="card-status" role="status" aria-live="polite">Front of demo member card shown.</p>
        <div class="wallet-state" aria-label="Future Wallet integrations are not live">
          <span><span aria-hidden="true">◈</span> Apple Wallet <small>NOT CONNECTED</small></span>
          <span><span aria-hidden="true">◉</span> Google Wallet <small>NOT CONNECTED</small></span>
        </div>
      </div>
      <div class="card-stage" id="card-scene">
        <div class="card-rotator" id="plastic-card">
          <div class="member-card card-front" id="card-front" aria-hidden="false">
            <div class="card-hologram" aria-hidden="true"></div>
            <div class="card-head"><div class="card-logo">BF<span>.</span><small>GYM GLOBAL</small></div><div class="card-class">DIGITAL<br/>FITNESS MEMBER</div></div>
            <div class="card-main">
              <div class="member-photo">
                <img src="/images/membership/demo-member.webp" alt="AI-generated portrait of a fictional example member, not a real BF GYM client" width="188" height="294" loading="eager"/>
              </div>
              <div class="member-info"><span class="member-key">SAMPLE MEMBER</span><strong>{demo.name}</strong><span class="membership-type">{demo.type}</span><span class="member-id">{demo.id}</span></div>
            </div>
            <div class="card-foot"><span>BF / GLOBAL FITNESS</span><strong>DEMO ONLY · NOT VALID ID</strong></div>
          </div>
          <div class="member-card card-back" id="card-back" aria-hidden="true">
            <div class="card-head"><div class="card-logo">BF<span>.</span><small>GYM GLOBAL</small></div><div class="back-number">BACK / 02</div></div>
            <div class="scan-panel">
              <div class="pseudo-qr" role="img" aria-label="Decorative, non-scannable QR placeholder. It contains no account or health information.">
                <svg viewBox="0 0 90 90" aria-hidden="true" focusable="false">
                  <rect width="90" height="90" fill="#f9fff4"/>
                  <path d="M7 7h21v21H7z M62 7h21v21H62z M7 62h21v21H7z" fill="none" stroke="#132216" stroke-width="6"/>
                  <rect x="15" y="15" width="5" height="5" fill="#132216"/><rect x="70" y="15" width="5" height="5" fill="#132216"/><rect x="15" y="70" width="5" height="5" fill="#132216"/>
                  <path d="M39 9h7v10h-7z M48 24h7v12h-7z M32 39h11v8H32z M55 38h10v7H55z M72 47h9v6h-9z M39 65h9v11h-9z M57 69h8v9h-8z M74 65h8v11h-8z" fill="#132216"/>
                  <rect x="23" y="38" width="47" height="18" rx="3" fill="#c7ff52"/>
                  <text x="46.5" y="50.5" font-size="10" text-anchor="middle" font-family="Arial" font-weight="900" fill="#172713">DEMO</text>
                </svg>
              </div>
              <div class="scan-copy"><strong>QR PLACEHOLDER</strong><span>NOT SCANNABLE</span><p>No member token, registration record or private health data is encoded here.</p></div>
            </div>
            <div class="back-band"><span>NOT A BANK, ATM, DEBIT OR IDENTITY CARD</span><strong>{demo.id}</strong></div>
            <p class="back-fine">A future membership verifier would return only an authorised membership status. Personal measurements would remain behind login.</p>
          </div>
        </div>
        <p class="under-card">ILLUSTRATION ONLY · 100% FICTIONAL MEMBER DETAILS · NOT AN ISSUED PASS</p>
      </div>
    </div>
  </section>
  <section class="dashboard-section wrap" aria-labelledby="dashboard-title">
    <div class="section-title"><div><p class="eyebrow">02 / HEALTH DETAILS STAY PRIVATE</p><h2 id="dashboard-title">A DASHBOARD.<br/><em>NOT A PUBLIC CARD.</em></h2></div><p>The Wallet pass should show only basic membership identity. In a future release, height, weight and training progress would sit behind a secure account — not on the card or in its QR code.</p></div>
    <div class="dash-toolbar"><div><span class="dash-status-dot" aria-hidden="true"></span><strong>FICTIONAL PRIVATE DASHBOARD</strong><p>Example data, not a real person or medical assessment.</p></div><button id="toggle-dashboard" type="button" class="outline-btn" aria-expanded="true" aria-controls="dashboard-preview">HIDE PREVIEW <span aria-hidden="true">−</span></button></div>
    <div id="dashboard-preview" class="dash-panel">
      <div class="dash-welcome">
        <div class="dash-avatar"><img src="/images/membership/demo-member.webp" alt="" width="55" height="55" loading="lazy"/></div>
        <div><span>WELCOME, EXAMPLE MEMBER</span><strong>{demo.name}</strong><small>PRIVATE FITNESS PROFILE MOCKUP</small></div>
        <div class="shield" aria-hidden="true">◈</div>
      </div>
      <div class="metrics">
        <article><span>WEIGHT</span><strong>{demo.weight}</strong><small>Fictional sample</small></article>
        <article><span>HEIGHT</span><strong>{demo.height}</strong><small>Fictional sample</small></article>
        <article><span>BMI</span><strong>{demo.bmi}</strong><small>Illustrative calculation</small></article>
        <article><span>WEEKLY WORKOUTS</span><strong>{demo.sessions}</strong><small>Fictional sessions</small></article>
      </div>
      <div class="dash-detail">
        <div><p class="eyebrow">GENERAL FITNESS INSIGHTS</p><h3>LEARN. TRAIN. REPEAT.</h3><p>BMI is only a rough height-to-weight screening metric, not a diagnosis or a complete measure of health. A real platform would need appropriate privacy, security, retention and professional controls before processing health measurements.</p></div>
        <div class="sample-week"><span>ILLUSTRATIVE TRAINING WEEK</span>
          <div class="mini-days" aria-label="Example weekly activity: Monday Wednesday Friday and Saturday completed">
            {['M','T','W','T','F','S','S'].map((letter,i)=><span class:list={['mini-day',{done:[0,2,4,5].includes(i)}]}>{letter}</span>)}
          </div>
          <p>4 sample sessions logged in a fictional week</p>
        </div>
      </div>
      <div class="privacy-strip"><strong>PRIVACY BY DESIGN</strong><span>No real weight, height, photo uploads, login credentials or identifiable customer information is collected here. This demo does not save your input or send information to a server.</span></div>
    </div>
  </section>
  <section class="steps-section" aria-labelledby="steps-title">
    <div class="wrap"><div class="section-title"><div><p class="eyebrow">03 / HOW A REAL VERSION WOULD WORK</p><h2 id="steps-title">FROM SIGN-UP<br/><em>TO PHONE WALLET.</em></h2></div><p>A proposed future journey — these services have not been developed or activated.</p></div>
    <div class="steps-grid">{features.map(item=><article><span class="step-number">{item.step}</span><h3>{item.name}</h3><p>{item.copy}</p></article>)}</div>
    <div class="phase-warning"><strong>PHASE 1 ONLY — NO REGISTRATION</strong><p>There is no sign-up form, real member ID, digital wallet issuance, financial account, scan verification, payment, referral reward or shared medical record on this page. Nothing here is a valid identity document. The future production system would need separate user authentication, consent and UK data-protection review before collecting health data.</p></div>
    </div>
  </section>
  <section class="founder wrap" aria-labelledby="founder-title">
    <div class="founder-photo"><img src="/images/trainer/adeep-portrait-new.webp" alt="BF GYM Global creator and fitness trainer Adeep Aji" width="400" height="480" loading="lazy"/></div>
    <div><p class="eyebrow">04 / ROOTS IN KERALA. BUILT IN THE UK.</p><h2 id="founder-title">A MALAYALI<br/><em>FITNESS VISION.</em></h2><p>BF GYM Global was created by <strong>Coach Adeep Aji</strong>, a Malayali personal trainer originally from Kerala, India, now based in the United Kingdom.</p><p>Made with the UK Malayali community in mind — and open to everyone who wants free, practical fitness learning, wherever they are.</p><p class="malayalam" lang="ml">കേരളത്തിൽ നിന്ന് യുകെയിലേക്ക് — ഫിറ്റ്നസിലൂടെ ഒരുമിച്ച് മുന്നോട്ട്.</p><div class="founder-actions"><a class="primary-btn" href="/kerala-uk/">OUR KERALA → UK STORY ↗</a><a class="text-link" href="/trainer/">MEET COACH ADEEP ↗</a></div></div>
  </section>
</main>
<footer class="footer wrap"><a href="/">BF<span>.</span> GYM GLOBAL</a><p>KERALA ROOTS · UK BASED · OPEN TO THE WORLD</p><div><a href="/privacy/">Privacy</a><a href="/programmes/">Free plans</a><a href="/app/">Fitness app</a></div></footer>
</div>
<script>
const flipButton = document.querySelector<HTMLButtonElement>('#flip-card');
const resetButton = document.querySelector<HTMLButtonElement>('#reset-card');
const rotator = document.querySelector<HTMLElement>('#plastic-card');
const front = document.querySelector<HTMLElement>('#card-front');
const back = document.querySelector<HTMLElement>('#card-back');
const cardStatus = document.querySelector<HTMLElement>('#card-status');
let flipped = false;
function renderFlip(next:boolean){
  flipped=next;
  rotator?.classList.toggle('is-flipped',flipped);
  flipButton?.setAttribute('aria-pressed',String(flipped));
  if(flipButton)flipButton.innerHTML = flipped?'SHOW CARD FRONT <span aria-hidden="true">↶</span>':'FLIP TO CARD BACK <span aria-hidden="true">↻</span>';
  front?.setAttribute('aria-hidden',String(flipped));
  back?.setAttribute('aria-hidden',String(!flipped));
  if(cardStatus)cardStatus.textContent=flipped?'Back of demo card shown. The QR illustration is not scannable.':'Front of demo member card shown.';
}
flipButton?.addEventListener('click',()=>renderFlip(!flipped));
resetButton?.addEventListener('click',()=>renderFlip(false));
const dashboardButton=document.querySelector<HTMLButtonElement>('#toggle-dashboard');
const dashboard=document.querySelector<HTMLElement>('#dashboard-preview');
dashboardButton?.addEventListener('click',()=>{
  if(!dashboard)return;
  const next=dashboard.hidden?true:false;
  dashboard.hidden=!next;
  dashboardButton.setAttribute('aria-expanded',String(next));
  dashboardButton.innerHTML=next?'HIDE PREVIEW <span aria-hidden="true">−</span>':'SHOW PREVIEW <span aria-hidden="true">+</span>';
});
</script>
</body>
</html>
<style>
