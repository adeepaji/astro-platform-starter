.topbar{display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:84px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:9px;white-space:nowrap;font:700 36px/.9 var(--display)}.brand span,.footer>a span{color:var(--lime)}.brand strong{font:900 16px var(--font);letter-spacing:.12em}.brand small{font-size:9px;color:var(--muted)}.topbar nav{display:flex;gap:24px}.topbar nav a,.nav-cta{font-size:10px;font-weight:900;letter-spacing:.08em}.topbar nav a:hover{color:var(--lime)}.nav-cta{border:1px solid var(--lime);padding:13px 14px}.eyebrow{font-size:11px;letter-spacing:.14em;color:var(--lime);font-weight:900}.live-dot,.fake-dot,.dash-status-dot{display:inline-block;background:var(--lime);width:8px;height:8px;border-radius:50%;margin-right:9px}
.hero{padding:75px 0 59px}.hero h1{font-size:clamp(74px,9.7vw,135px);line-height:.96;margin:25px 0 22px;font-weight:650}.hero-lede{font-size:17px;line-height:1.8;max-width:780px;color:#cbd8c5}.demo-status{display:flex;flex-wrap:wrap;gap:14px;align-items:center;border:1px solid #58724e;background:#263825;padding:16px 21px;margin-top:32px;max-width:925px}.demo-status strong{color:var(--lime);font-size:11px;letter-spacing:.11em}.demo-status span{font-size:12px;color:#d3e3cb}
.preview-section{background:#1b281b;padding:74px 0 88px;overflow:hidden}.preview-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:60px;align-items:center}.preview-copy h2,.section-title h2,.founder h2{font-size:clamp(58px,6.2vw,88px);margin:17px 0 23px;font-weight:600}.preview-copy>p:not(.eyebrow),.section-title>p,.founder p:not(.eyebrow){color:#c7d7c0;line-height:1.88}.example-tag{display:inline-flex;align-items:center;padding:11px 14px;background:#283b28;border:1px solid #58724f;color:#e0f0d9;font-size:10px;font-weight:900;letter-spacing:.08em;margin-top:18px}.card-controls{display:flex;flex-wrap:wrap;gap:10px;margin:26px 0 6px}.primary-btn{display:inline-flex;gap:14px;align-items:center;justify-content:center;background:var(--lime);color:#182b16;padding:14px 19px;font-size:11px;font-weight:900;letter-spacing:.05em;border:1px solid var(--lime)}.ghost-btn,.outline-btn{border:1px solid #7b9971;background:transparent;color:#e0f3d8;padding:14px 19px;font-size:11px;font-weight:900}.device-note{font-size:11px;color:#a9bba2}.wallet-state{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}.wallet-state>span{display:grid;grid-template-columns:auto auto;column-gap:10px;align-items:center;padding:11px 15px;border:1px dashed #6f8767;color:#d7e7d1;font-size:11px}.wallet-state>span>span{grid-row:span 2;color:var(--lime);font-size:19px}.wallet-state small{font-size:9px;color:#abbea5}
