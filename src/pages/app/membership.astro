:#c6ebaf;font-weight:900}.member-info strong{font:700 clamp(27px,4.2vw,43px)/1.12 var(--display);margin:11px 0}.membership-type{font-size:11px;letter-spacing:.1em;font-weight:800;color:#e6f6d6}.member-id{font:600 clamp(15px,2.3vw,21px) var(--display);letter-spacing:.1em;color:var(--lime);margin-top:12px}.card-foot{display:flex;justify-content:space-between;gap:13px;padding-top:15px;border-top:1px solid #d0e6c073;font-size:10px;letter-spacing:.06em;font-weight:800}.card-foot strong{color:var(--lime)}.card-back{transform:rotateY(180deg)}.scan-panel{display:flex;align-items:center;gap:25px;margin:auto 0}.pseudo-qr{width:clamp(90px,11vw,130px);aspect-ratio:1;background:white;border:6px solid white;flex-shrink:0}.pseudo-qr svg{width:100%;height:100%;display:block}.scan-copy strong{font:700 clamp(20px,2.8vw,30px) var(--display)}.scan-copy span{display:block;color:var(--lime);font-size:10px;letter-spacing:.1em;font-weight:800}.scan-copy p{font-size:11px;line-height:1.6;color:#d1e1c9;margin:9px 0 0}.back-band{display:flex;justify-content:space-between;gap:15px;align-items:center;border-top:1px solid #6e8d63;padding:12px 0;font-size:9px;font-weight:900;letter-spacing:.07em}.back-band strong{font:600 17px var(--display);color:var(--lime)}.back-fine{font-size:9px;color:#c4d7b9;margin:0}.under-card{text-align:center;color:#91ab85;font-size:10px;font-weight:800;letter-spacing:.09em;margin:25px 0 0}
