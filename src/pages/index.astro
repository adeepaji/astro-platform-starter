    </section>
    <section class="community-card" aria-labelledby="community-heading"><div class="community-icon" aria-hidden="true">♡</div><div><span class="mini-label">KEEP IN TOUCH</span><h2 id="community-heading">Follow the journey on Instagram.</h2><p>See Coach Adeep at <strong>@fitwithaadhi</strong>. The BF GYM site itself doesn't ask you to connect a social account.</p></div><a href="https://www.instagram.com/fitwithaadhi/" target="_blank" rel="noopener noreferrer" class="btn-outline">Visit Instagram ↗</a></section>
    <footer class="main-footer"><strong>BF GYM GLOBAL</strong><span>Best Fitness · Free fitness education</span><div><a href="/privacy/">Privacy</a><a href="/trainer/">Meet the coach</a><a href="/ml/kerala-uk/" lang="ml">മലയാളം</a><a href="/app/membership/">Member card demo</a></div><p>Paid coaching, bookings, real membership registration and Wallet passes are not active. Workout progress and saved posts are device-only. BF GYM is an independent site and is not affiliated with Instagram or Threads.</p></footer>
  </main>

  <aside class="right-sidebar" aria-label="Coach and site information">
    <div class="coach-panel"><div class="panel-title"><span class="panel-dot" aria-hidden="true"></span> MEET THE FOUNDER</div><div class="coach-top"><img src="/images/trainer/adeep-portrait-new.webp" width="66" height="66" alt="Coach Adeep Aji"/><div><h2>Coach Adeep</h2><p>Kerala <span aria-hidden="true">→</span> UK 🇮🇳🇬🇧</p></div></div><p>A fitness learning space created to help people start simply and build sustainable habits.</p><a href="/trainer/">Read the coach profile <span aria-hidden="true">↗</span></a></div>
    <div class="safe-panel"><span class="safe-symbol" aria-hidden="true">✓</span><h2>Feel free to explore.</h2><p>There is no sign-in gate, no subscription checkout and no public profile to create.</p><ul><li>Free workout plans</li><li>Easy exercise learning</li><li>Device-only saved posts</li></ul><a href="/privacy/">How privacy works ↗</a></div>
    <a class="malayalam-panel" href="/ml/kerala-uk/" hreflang="ml"><span lang="ml">മലയാളത്തിൽ വായിക്കാം</span><small>Our Kerala → UK story ↗</small></a>
  </aside>
</div>
<nav class="bottom-nav" aria-label="Mobile navigation">
  <a href="/" aria-current="page"><span aria-hidden="true">⌂</span><small>Home</small></a>
  <a href="/programmes/"><span aria-hidden="true">▤</span><small>Plans</small></a>
  <a href="/start/" class="bottom-start"><span aria-hidden="true">✦</span><small>Start</small></a>
  <a href="/app/workouts/"><span aria-hidden="true">▷</span><small>Videos</small></a>
  <a href="/trainer/"><span aria-hidden="true">☺</span><small>Coach</small></a>
</nav>
<script>
  // Editorial feed only: no login, no public posts, no analytics and no network requests.
  // Save preferences are stored in this browser only and can be cleared with browser data.
  const saveKey = 'bfgym-feed-saved-v1';
  const filters = Array.from(document.querySelectorAll('[data-filter]'));
  const cards = Array.from(document.querySelectorAll('[data-post-id]'));
  const saveButtons = Array.from(document.querySelectorAll('[data-save]'));
  const search = document.getElementById('feed-search');
  const empty = document.getElementById('empty-feed');
  const reset = document.getElementById('reset-feed');
  let selected = 'all';
  let saved = new Set();
  try {
    const stored = JSON.parse(localStorage.getItem(saveKey) || '[]');
    if (Array.isArray(stored)) saved = new Set(stored.filter(id => typeof id === 'string'));
  } catch (_) { /* storage may be blocked; in-memory saves still work */ }
  function renderSaved() {
    saveButtons.forEach(button => {
      const on = saved.has(button.dataset.save);
      button.setAttribute('aria-pressed', String(on));
      button.classList.toggle('is-saved', on);
      const label = button.querySelector('span');
      if (label) label.textContent = on ? 'Saved' : 'Save';
      button.setAttribute('aria-label', on ? 'Remove this post from saved on this device' : 'Save this post on this device');
    });
  }
  function renderFeed() {
    const query = (search && search.value ? search.value : '').trim().toLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const topic = card.dataset.topic || '';
      const matchTopic = selected === 'all' || (selected === 'saved' ? saved.has(card.dataset.postId) : selected === topic);
      const matchSearch = !query || (card.dataset.search || '').includes(query);
      card.hidden = !(matchTopic && matchSearch);
      if (!card.hidden) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  }
  filters.forEach(button => button.addEventListener('click', () => {
    selected = button.dataset.filter || 'all';
    filters.forEach(item => { const active = item === button; item.classList.toggle('active',active); item.setAttribute('aria-pressed',String(active)); });
    renderFeed();
  }));
  saveButtons.forEach(button => button.addEventListener('click', () => {
    const id = button.dataset.save;
    if (!id) return;
    if (saved.has(id)) saved.delete(id); else saved.add(id);
    try { localStorage.setItem(saveKey, JSON.stringify(Array.from(saved))); } catch (_) {}
    renderSaved();
    renderFeed();
  }));
  if (search) search.addEventListener('input',renderFeed);
  if (reset) reset.addEventListener('click', () => {
    if (search) search.value = '';
    const allButton = filters.find(button => button.dataset.filter === 'all');
    if (allButton) allButton.click();
    if (search) search.focus();
  });
  renderSaved();
  renderFeed();
</script>
