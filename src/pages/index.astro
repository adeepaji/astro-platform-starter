---
import { services } from '../data/services';
import { commercialServicesEnabled, publicEnquiriesEnabled } from '../data/businessLaunch';
const year = new Date().getFullYear();
const programmes = [
  {number: '01', name: '1:1 Personal Training', tag: 'PERSONAL', text: 'Individual coaching built around your goals, experience and lifestyle.', details: ['Personalised sessions', 'Technique & accountability']},
  {number: '02', name: 'Small Group Fitness', tag: 'COMMUNITY', text: 'Train with others in energetic, supportive, coach-led sessions.', details: ['Strength & conditioning', 'Motivation together']},
  {number: '03', name: 'Online Coaching', tag: 'ANYWHERE', text: 'Get expert guidance and a flexible routine wherever you train.', details: ['Flexible training approach', 'Ongoing progression']},
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#101310" />
  <meta name="description" content="BF GYM Global: UK-based online fitness education for an international audience. Explore free workout demonstrations and upcoming online coaching." />
  <title>BF GYM Global — Train With Purpose</title>
  <link rel="icon" href="/bf-icon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/app-icon-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a href="#top" class="brand" aria-label="BF GYM home"><span class="brand-mark">BF<span class="brand-dot">.</span></span><span class="brand-name">GYM<span> / GLOBAL ONLINE FITNESS</span></span></a>
      <nav aria-label="Main navigation">
        <a href="#programmes">Programmes</a><a href="#pricing">Pricing</a><a href="/app/">Mobile App</a><a href="/app/workouts/">Workout Videos</a><a href="/sample-plan/">Sample Plan</a>
        <a href="#approach">Our approach</a>
        <a href="#about">About</a>
      </nav>
      <a class="nav-cta" href="/book/">VIEW COACHING PLANS <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="shell hero-layout">
        <div class="hero-copy">
          <div class="eyebrow"><span class="live-dot"></span> UK-BASED · ONLINE FITNESS · WORLDWIDE AUDIENCE</div>
          <h1 id="hero-title">TRAIN<br /><span class="hollow">WITH</span><br />PURPOSE<span class="lime">.</span></h1>
          <p class="hero-lede">A global fitness learning hub with weight training, cardio and HIIT demonstrations. Live online coaching is planned for a later launch.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/book/">EXPLORE ONLINE COACHING <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#programmes">EXPLORE PROGRAMMES <span aria-hidden="true">↓</span></a><a class="text-link" href="/app/">OPEN MOBILE APP <span aria-hidden="true">↗</span></a><a class="text-link" href="/app/workouts/">WATCH WORKOUT DEMOS <span aria-hidden="true">▶</span></a><a class="text-link" href="/sample-plan/">SAMPLE WORKOUT &amp; DIET PLAN <span aria-hidden="true">↗</span></a>
          </div>
          <div class="micro-trust"><div class="avatar-letters" aria-hidden="true">BF</div><div><strong>Coaching for real life</strong><br />Beginners welcome · Every level supported</div></div>
        </div>
        <div class="hero-visual" aria-label="Motivational fitness graphic">
          <div class="visual-grid"></div>
          <div class="visual-top">THE WORK YOU PUT IN<br />BECOMES THE PERSON YOU ARE.</div>
          <div class="visual-rings"><span></span><span></span><span></span><div class="visual-centre"><small>BUILT ON</small><strong>YOU.</strong></div></div>
          <div class="visual-bottom"><div><span>01 /</span> SHOW UP</div><div><span>02 /</span> GET STRONGER</div><div><span>03 /</span> KEEP GOING</div></div>
          <div class="visual-side">MOVE WITH INTENTION — BF GYM</div>
        </div>
      </div>
      <div class="shell scroll-indicator"><span>SCROLL TO EXPLORE</span><div></div><span>01 / 04</span></div>
    </section>
    <section class="intro-band" aria-label="Our coaching values"><div class="shell band-inner"><span>STRENGTH</span><span class="band-star">✳</span><span>CONFIDENCE</span><span class="band-star">✳</span><span>CONSISTENCY</span><span class="band-star">✳</span><span>PROGRESS</span></div></section>
    <section id="programmes" class="section programmes" aria-labelledby="programmes-title">
      <div class="shell">
        <div class="section-head">
          <div><p class="section-kicker">01 / PLANNED ONLINE PROGRAMMES</p><h2 id="programmes-title">YOUR GOALS.<br /><span>YOUR PROGRAMME.</span></h2></div>
          <p>Built for fitness learners worldwide. Live online sessions will become available only after business launch checks are complete.</p>
        </div>
        <div class="programme-grid">
          {programmes.map((p) => (
            <article class="programme-card">
              <div class="card-top"><span>{p.number} /</span><span class="pill">{p.tag}</span></div>
              <div class="card-graphic" aria-hidden="true"><span class="card-ring"></span><span class="card-symbol">{p.number}</span></div>
              <h3>{p.name}</h3><p>{p.text}</p>
              <ul>{p.details.map((d) => <li>{d}</li>)}</ul>
              <a href="#enquire" aria-label={'Enquire about ' + p.name}>ASK ABOUT THIS PROGRAMME <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="availability-note">Class times, locations and package prices are provided when you enquire. Programmes are subject to availability.</p>
      </div>
    </section>
    <section class="section pricing-section" id="pricing" aria-labelledby="pricing-title">
  <div class="shell">
    <div class="section-head">
      <div><p class="section-kicker">02 / PLANNED GLOBAL PROGRAMMES</p><h2 id="pricing-title">INVEST IN<br/><span>YOURSELF.</span></h2></div>
      <p>Our planned services will be delivered online from the UK to international clients. Booking and payments are not yet active.</p>
    </div>
    <div class="price-grid">
      {services.map((service) => (
        <article class="price-card">
          <div class="price-top"><span>{service.eyebrow}</span><span>BF / {service.id.toUpperCase()}</span></div>
          <h3>{service.title}</h3>
          <p class="price-description">{service.description}</p>
          {commercialServicesEnabled ? (
            <div class="price-value">£{service.price}<small>{service.unit}</small></div>
          ) : (
            <div class="price-value price-pending">OPENING SOON<small>Price and availability to be confirmed</small></div>
          )}
          <ul>{service.details.map((detail) => <li>{detail}</li>)}</ul>
          <a class="btn btn-primary price-action" href={service.bookingUrl || '/book/?service=' + service.id} target={service.bookingUrl ? '_blank' : undefined} rel={service.bookingUrl ? 'noopener noreferrer' : undefined}>
            {service.bookingUrl ? 'CHECK AVAILABILITY' : commercialServicesEnabled ? 'REQUEST THIS SERVICE' : 'LEARN ABOUT THIS PLAN'} <span aria-hidden="true">↗</span>
          </a>
          {service.id === 'online' && service.paymentUrl && (
            <a class="secondary-pay" href={service.paymentUrl} target="_blank" rel="noopener noreferrer">START ONLINE SUBSCRIPTION ↗</a>
          )}
        </article>
      ))}
    </div>
    <p class="price-fine">No sale or session is currently offered for booking. Prices remain internal draft proposals; online availability, terms and accepted currencies will be confirmed before a commercial launch.</p>
    <div class="booking-mini"><strong>GLOBAL ONLINE FITNESS</strong><p>Explore the fitness video library while coaching services are in preparation. We will announce pricing and availability after launch review.</p><a href="/app/workouts/">EXPLORE EXERCISES <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<section class="section approach" id="approach" aria-labelledby="approach-title">
      <div class="shell approach-layout">
        <div class="approach-panel"><div class="panel-corner">BF / METHOD</div><div class="big-method">BETTER<br />EVERY<br /><span>DAY.</span></div><div class="panel-bottom">NO SHORTCUTS. JUST THE RIGHT SUPPORT.</div></div>
        <div class="approach-copy"><p class="section-kicker">02 / HOW WE COACH</p><h2 id="approach-title">PROGRESS<br />WITHOUT THE<br /><span>PRESSURE.</span></h2>
          <div class="method-item"><span>01</span><div><h3>Start where you are</h3><p>We discuss your goals, preferences and training background before shaping an approach.</p></div></div>
          <div class="method-item"><span>02</span><div><h3>Build habits that stick</h3><p>Focused training, guidance and consistency — designed for a busy life.</p></div></div>
          <div class="method-item"><span>03</span><div><h3>Keep moving forward</h3><p>Review your progress and adjust your routine as your confidence and abilities grow.</p></div></div>
          <a href="#enquire" class="text-link">LET'S TALK ABOUT YOUR GOALS <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="shell about-layout"><div><p class="section-kicker">03 / WHY BF GYM</p><h2 id="about-title">KNOWLEDGE.<br />ENERGY.<br /><span>ACCOUNTABILITY.</span></h2></div>
        <div class="about-detail"><p class="about-lede">Fitness coaching should make you feel capable, not overwhelmed.</p><p>BF GYM is built around practical guidance, personal attention and steady improvement. Whether you're starting out or returning to training, the aim is to help you build a routine you can maintain.</p><div class="qualifications"><span>TRAINER BACKGROUND</span><ul><li>5+ years' personal training experience</li><li>Advanced personal training qualifications</li><li>Female fitness & special population training certifications</li></ul></div></div></div>
    </section>
    <section class="section enquiry" id="enquire" aria-labelledby="enquire-title">
      <div class="shell enquiry-layout">
        <div class="enquiry-copy"><p class="section-kicker">04 / GLOBAL LAUNCH STATUS</p><h2 id="enquire-title">BE PART OF<br /><span>WHAT'S NEXT.</span></h2><p>BF GYM Global is preparing its international online coaching services. In the meantime you can explore the free video library and plan your training.</p><div class="enquiry-aside"><span>NOT SURE WHERE TO START?</span><p>Start with the free demonstrations for strength training, cardio and HIIT. Coaching and paid subscriptions will be introduced after launch checks.</p></div></div>
        {publicEnquiriesEnabled ? (<div class="form-frame"><div class="form-header"><strong>ENQUIRE ABOUT COACHING</strong><span>BF / CONTACT</span></div>
          <form name="bf-gym-enquiries" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="website">
            <input type="hidden" name="form-name" value="bf-gym-enquiries" />
            <p class="honeypot"><label>Leave this field empty: <input name="website" autocomplete="off" /></label></p>
            <div class="form-row"><label>Your name <input type="text" name="name" autocomplete="name" placeholder="Full name" required maxlength="100" /></label><label>Email address <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" /></label></div>
            <label>Interested in <select name="programme" required><option value="" disabled selected>Select a programme</option><option>1:1 Personal Training</option><option>Small Group Fitness</option><option>Online Coaching</option><option>Not sure yet</option></select></label>
            <label>Your message (optional) <textarea name="message" rows="4" maxlength="1500" placeholder="Tell us about your preferred sessions or schedule. Please don't include medical information."></textarea></label>
            <p class="privacy-note">We’ll use your contact details only to respond to this enquiry. Please don't submit sensitive health information. Read our <a href="/privacy/">privacy information</a>.</p>
            <button type="submit" class="btn btn-primary submit-btn">SEND ENQUIRY <span aria-hidden="true">↗</span></button>
            <p class="form-help">Enquiries will be processed after the website owner enables Netlify Forms.</p>
          </form>
        </div>) : (<div class="form-frame"><div class="form-header"><strong>INTERNATIONAL PRE-LAUNCH</strong><span>BF / GLOBAL</span></div><h3>COACHING ENQUIRIES OPEN LATER</h3><p>Our live coaching, subscriptions and contact forms are temporarily unavailable while business terms and privacy arrangements are finalised.</p><a class="btn btn-primary" href="/app/workouts/">EXPLORE THE FREE EXERCISE LIBRARY <span aria-hidden="true">↗</span></a><p class="form-help">No payments, customer accounts or bookings are being accepted at this stage.</p></div>)}
      </div>
    </section>
  </main>
  <footer class="footer"><div class="shell footer-top"><a href="#top" class="brand"><span class="brand-mark">BF<span class="brand-dot">.</span></span><span class="brand-name">GYM</span></a><p>TRAIN WITH PURPOSE.<br />LONDON & ONLINE.</p><a href="#top">BACK TO TOP ↑</a></div><div class="shell footer-bottom"><span>© {year} BF GYM. All rights reserved.</span><span>Website launch edition · <a href="/app/">Mobile App</a> · <a href="/app/workouts/">Workout Videos</a> · <a href="/sample-plan/">Sample Plan</a> · <a href="/privacy/">Privacy information</a> · <a href="/book/">Session requests</a></span></div></footer>
</body>
</html>
<style is:global>
:root{--bg:#101310;--surface:#191d19;--surface2:#222822;--line:#343a31;--lime:#c7ff52;--cream:#f2f3e9;--muted:#a4a99d;--display:'Oswald',Impact,sans-serif;--body:'DM Sans',Arial,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--cream);font-family:var(--body);font-size:15px;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}
button,a,input,select,textarea{outline-offset:4px}button{cursor:pointer}
::selection{background:var(--lime);color:var(--bg)}
.shell{width:min(1192px,calc(100% - 72px));margin-inline:auto}
.skip-link{position:absolute;top:-80px;left:12px;padding:12px;background:var(--lime);color:var(--bg);z-index:100}.skip-link:focus{top:12px}
.site-header{position:relative;z-index:5;border-bottom:1px solid rgba(255,255,255,.10);background:#101310}
.header-inner{height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:12px}.brand-mark{font:700 36px/.8 var(--display);letter-spacing:-2px}.brand-dot{color:var(--lime)}.brand-name{font-weight:800;font-size:16px;letter-spacing:.05em;line-height:1}.brand-name span{display:block;margin-top:5px;color:var(--muted);font-size:9px;letter-spacing:.16em;font-weight:700}
nav{display:flex;align-items:center;gap:33px}nav a{font-size:12px;font-weight:700;color:#c3c7bf;transition:color .2s}nav a:hover,.footer a:hover{color:var(--lime)}
.nav-cta{display:inline-flex;align-items:center;gap:24px;padding:15px 18px;border:1px solid var(--lime);font-weight:800;font-size:11px;letter-spacing:.08em}.nav-cta span{font-size:18px;color:var(--lime)}
.hero{overflow:hidden;padding-top:74px;background:radial-gradient(ellipse at 5% 30%,#1c2515 0%,transparent 55%),var(--bg)}
.hero-layout{display:grid;grid-template-columns:1.08fr .92fr;align-items:stretch;min-height:650px;gap:32px}
.hero-copy{padding:22px 0 56px}.eyebrow,.section-kicker{font-size:11px;letter-spacing:.19em;font-weight:800;color:var(--lime)}.eyebrow{display:flex;align-items:center;gap:11px}.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px #c7ff521a}
h1,h2,h3,p{margin-top:0}h1,h2,.big-method{font-family:var(--display);font-weight:600;line-height:.99;letter-spacing:-.017em}h1{font-size:clamp(92px,10vw,157px);margin:30px 0 24px}.hollow{color:transparent;-webkit-text-stroke:2px var(--cream)}.lime{color:var(--lime)}
.hero-lede{max-width:420px;color:#bec4b9;font-size:17px;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:25px;margin-top:32px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:space-between;gap:36px;padding:19px 24px;border:0;font-weight:800;font-size:12px;letter-spacing:.07em;transition:transform .2s,background-color .2s}.btn:hover{transform:translateY(-3px)}.btn-primary{background:var(--lime);color:var(--bg)}.btn-primary:hover{background:#daff90}.btn span{font-size:19px}.text-link{font-size:11px;font-weight:800;letter-spacing:.07em;border-bottom:1px solid #72796c;padding-bottom:7px;display:inline-flex;align-items:center;gap:12px}.text-link:hover{color:var(--lime);border-color:var(--lime)}
.micro-trust{display:flex;align-items:center;gap:14px;margin-top:68px;font-size:11px;line-height:1.8;color:var(--muted)}.micro-trust strong{color:var(--cream)}.avatar-letters{width:43px;height:43px;background:#313a2e;border:1px solid #5e6c4d;border-radius:50%;color:var(--lime);display:grid;place-items:center;font:700 17px var(--display)}
.hero-visual{min-height:620px;position:relative;overflow:hidden;background:linear-gradient(145deg,#283324,#18221b 60%,#141d16);border:1px solid #364335}
.visual-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(135deg,#000,transparent 90%)}
.visual-top{position:absolute;top:34px;left:34px;color:#d4dfc9;font-size:10px;line-height:1.8;font-weight:800;letter-spacing:.11em}
.visual-rings{position:absolute;inset:13% -25%;display:grid;place-items:center;transform:rotate(-17deg)}.visual-rings>span{position:absolute;border:2px solid #b6ee4d66;border-radius:50%;width:66%;aspect-ratio:1;transform:scaleX(.80)}.visual-rings>span:nth-child(2){width:87%;border-color:#b6ee4d33}.visual-rings>span:nth-child(3){width:109%;border-color:#b6ee4d18}.visual-centre{position:relative;transform:rotate(17deg);text-align:center;z-index:2}.visual-centre small{display:block;font-size:13px;letter-spacing:.25em;color:var(--lime);font-weight:700}.visual-centre strong{display:block;font:700 clamp(105px,12vw,180px)/1 var(--display);letter-spacing:-.07em;color:var(--lime);text-shadow:0 0 50px #c7ff5228}
.visual-bottom{position:absolute;bottom:35px;left:34px;right:34px;display:flex;justify-content:space-between;gap:12px;padding-top:20px;border-top:1px solid #798b683e;font-size:9px;letter-spacing:.09em;font-weight:800}.visual-bottom span{color:var(--lime)}.visual-side{position:absolute;right:19px;top:30px;font-size:9px;writing-mode:vertical-rl;letter-spacing:.16em;color:#b9d2a9}
.scroll-indicator{display:flex;align-items:center;gap:16px;color:#888f85;font-size:9px;letter-spacing:.18em;font-weight:700;padding:18px 0 24px}.scroll-indicator div{width:120px;height:1px;background:#4e5849}.scroll-indicator span:last-child{margin-left:auto}
.intro-band{background:var(--lime);color:var(--bg);overflow:hidden}.band-inner{min-height:73px;display:flex;align-items:center;justify-content:space-between;gap:24px;font:600 clamp(16px,2.2vw,26px) var(--display);letter-spacing:.01em}.band-star{font:400 23px var(--body)}
.section{padding:115px 0}.section-kicker{margin-bottom:25px}h2{font-size:clamp(57px,6.2vw,92px);margin-bottom:0}h2 span{color:var(--lime)}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:60px;margin-bottom:45px}.section-head>p{color:var(--muted);max-width:305px;line-height:1.8;margin:0}
.programme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.programme-card{background:var(--surface);border:1px solid var(--line);padding:27px;min-width:0;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}.programme-card:hover{transform:translateY(-4px);border-color:#6c8b48}.card-top{display:flex;align-items:center;justify-content:space-between;font-weight:800;font-size:12px;color:var(--lime)}.pill{color:#b4c6a1;border:1px solid #475542;padding:8px 11px;border-radius:40px;font-size:9px;letter-spacing:.15em}.card-graphic{height:190px;position:relative;display:grid;place-items:center;overflow:hidden}.card-ring{position:absolute;width:150px;height:150px;border:1px solid #6b8954;border-radius:50%;transform:rotate(-22deg) scaleX(1.3)}.card-ring:after{content:"";position:absolute;inset:17px;border:1px solid #465b39;border-radius:50%}.card-symbol{font:600 110px var(--display);color:#b1e94e26}.programme-card h3{font:600 28px var(--display);text-transform:uppercase;margin:5px 0 11px}.programme-card>p{color:var(--muted);line-height:1.7;min-height:80px;font-size:13px}.programme-card ul{list-style:none;padding:16px 0 20px;margin:0;border-top:1px solid var(--line)}.programme-card li{font-size:12px;margin:10px 0;color:#d3d8ce}.programme-card li:before{content:"+";color:var(--lime);margin-right:12px}.programme-card>a{border-top:1px solid var(--line);padding-top:24px;font-size:10px;font-weight:800;letter-spacing:.08em;display:flex;align-items:center;justify-content:space-between;margin-top:auto}.programme-card>a span{font-size:18px;color:var(--lime)}.availability-note{font-size:11px;color:#999e96;margin:22px 0 0}
.approach{background:#1b211a}.approach-layout{display:grid;grid-template-columns:1fr 1fr;gap:10%}.approach-panel{min-height:630px;background:linear-gradient(150deg,#d4ff70,#a6d93c);color:#141812;padding:32px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.approach-panel:before{content:"";width:520px;height:520px;border:1px solid #59742b63;position:absolute;border-radius:50%;top:-150px;right:-180px}.panel-corner,.panel-bottom{font-weight:800;font-size:10px;letter-spacing:.15em;z-index:1}.big-method{font-size:clamp(76px,9vw,126px);z-index:1}.big-method span{color:#f1f6d9}
.approach-copy{align-self:center;padding:28px 0}.approach-copy h2{font-size:clamp(51px,5.2vw,81px);margin-bottom:40px}.method-item{display:grid;grid-template-columns:42px 1fr;gap:20px;border-top:1px solid #455040;padding:23px 0}.method-item>span{color:var(--lime);font-weight:800;font-size:11px}.method-item h3{font-size:17px;margin-bottom:8px}.method-item p{color:var(--muted);font-size:13px;line-height:1.8;margin:0}.approach-copy>.text-link{margin-top:24px}
.about-layout{display:grid;grid-template-columns:1fr 1fr;gap:10%}.about-detail{padding-top:72px}.about-lede{font-size:24px;line-height:1.5;font-weight:600}.about-detail>p:not(.about-lede){color:var(--muted);line-height:1.9}.qualifications{border-top:1px solid var(--line);margin-top:36px;padding-top:25px}.qualifications>span{color:var(--lime);font-size:11px;font-weight:800;letter-spacing:.12em}.qualifications ul{list-style:none;padding:0;margin:15px 0}.qualifications li{margin:12px 0;font-size:13px}.qualifications li:before{content:"↗";margin-right:13px;color:var(--lime)}
