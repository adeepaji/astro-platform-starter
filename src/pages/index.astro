                <span class="local-note">Private to this device</span>
              </div>
              <a href={post.href} class="post-link">{post.cta} <span aria-hidden="true">↗</span></a>
            </footer>
            <div class="post-secondary"><a href={post.secondaryHref} lang={post.secondaryHref.startsWith('/ml/')?'ml':undefined}>{post.secondary} <span aria-hidden="true">→</span></a></div>
