<script>
  const days = document.querySelector<HTMLElement>('.starter-days');
  const dayButtons = Array.from(days?.querySelectorAll('button') ?? []);
  const sessions = document.querySelectorAll<HTMLElement>('.starter-workouts .starter-session');

  function showDay(selectedIndex: number) {
    dayButtons.forEach((button, index) => {
      const selected = index === selectedIndex;
      button.setAttribute('aria-pressed', String(selected));
      sessions[index].hidden = !selected;
    });
  }

  if (days && dayButtons.length === sessions.length && sessions.length > 0) {
    dayButtons.forEach((button, index) => button.addEventListener('click', () => showDay(index)));
    showDay(0);
    days.hidden = false;
  }
</script>
