                <img src={post.image} width="680" height="340" alt={post.alt} loading="lazy"/>
                <span class="photo-strap">FROM KERALA TO THE UK <span aria-hidden="true">↗</span></span>
              </a>
            ):(
              <a href={post.href} class:list={['post-media','graphic-media',post.visual]} aria-label={post.cta}>
                <span class="graphic-kicker">BF GYM GLOBAL <span>✳</span> BEST FITNESS</span>
                <strong>{post.graphicTitle}</strong>
                <span class="graphic-sub">{post.graphicSub}</span>
                <span class="graphic-circle" aria-hidden="true"></span>
              </a>
            )}
            <footer class="post-footer">
              <div class="post-controls">
