---
import { programmeVideoSearch, trainingProgrammes } from '../data/trainingProgrammes';

const beginnerSchedule = trainingProgrammes[0].schedule;
const starterSessions = [
  beginnerSchedule.find(session => session.label === 'Full-body foundations A')!,
  beginnerSchedule.find(session => session.kind === 'Cardio')!,
  beginnerSchedule.find(session => session.label === 'Full-body foundations B')!
];
const year = new Date().getFullYear();
const programmes = [
  {number:'01',name:'BEGINNER',label:'BUILD THE FOUNDATION',description:'Get comfortable with the basics. Follow a simple four-week example and build consistency.',detail:'FREE 4-WEEK PLAN',href:'/programmes/?level=beginner',tone:'beginner'},
  {number:'02',name:'INTERMEDIATE',label:'BUILD MOMENTUM',description:'Explore more structured sessions and keep developing your strength and fitness.',detail:'FREE 4-WEEK PLAN',href:'/programmes/?level=intermediate',tone:'intermediate'},
  {number:'03',name:'ADVANCED',label:'TRAIN WITH INTENT',description:'Take a look at more demanding example workouts and refine your training approach.',detail:'FREE 4-WEEK PLAN',href:'/programmes/?level=advanced',tone:'advanced'}
];
const features = [
  {number:'01',icon:'▤',title:'Structured workout plans',description:'Beginner to advanced four-week examples, all free to explore.',url:'/programmes/'},
  {number:'02',icon:'▶',title:'Exercise demonstrations',description:'Explore curated videos and search hundreds of exercises to learn the movement.',url:'/app/workouts/'},
  {number:'03',icon:'◉',title:'Private progress tracker',description:'Mark workouts as complete. Your history stays in this browser on your device.',url:'/app/dashboard/'},
  {number:'04',icon:'↗',title:'Start without signing up',description:'No login gate, payment details or active paid coaching required to begin.',url:'/start/'}
];
const steps = [
  {number:'01',title:'FIND YOUR STARTING POINT',description:'Choose the experience level that makes sense for you, with no pressure to be perfect.'},
  {number:'02',title:'LEARN THE MOVEMENT',description:'Use the exercise library to understand technique before putting it into practice.'},
  {number:'03',title:'BUILD YOUR OWN CONSISTENCY',description:'Explore a routine and record your completed workouts privately on this device.'}
];
