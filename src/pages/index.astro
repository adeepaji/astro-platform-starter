            <header class="post-header">
              <a class="post-avatar" href="/trainer/" aria-label="Meet Coach Adeep"><img src="/images/trainer/adeep-portrait-new.webp" width="45" height="45" alt=""/></a>
              <div class="post-meta"><div class="post-author"><strong>BF GYM Global</strong><span class="verified-meaning" title="BF means Best Fitness">BF</span></div><span class="post-subtitle">{post.label} · <span>by Coach Adeep</span></span></div>
              <span class="post-type" aria-label={'Post topic: '+post.topic}>{post.topic}</span>
            </header>
            <div class="post-copy"><h3>{post.title}</h3><p>{post.text}</p></div>
            {post.visual==='coach' ? (
