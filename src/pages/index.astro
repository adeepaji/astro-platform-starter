<script>
 const raw = document.getElementById('match-data');
 let matches = [];
 try { matches = JSON.parse(raw.textContent || '[]'); } catch (_) {}
 const screen = document.getElementById('match-card');
 const media = document.getElementById('match-media');
 const els = {
  type:document.getElementById('match-type'),
  glyph:document.getElementById('match-glyph'),
  vibe:document.getElementById('match-vibe'),
  tagline:document.getElementById('match-tagline'),
  title:document.getElementById('match-title'),
  subtitle:document.getElementById('match-subtitle'),
  description:document.getElementById('match-description'),
  link:document.getElementById('open-match'),
  count:document.getElementById('match-counter'),
  dots:document.getElementById('match-dots'),
  hint:document.getElementById('match-hint'),
  liked:document.getElementById('liked-list'),
  clear:document.getElementById('clear-likes')
 };
 const key = 'bfgym-workout-matches-v1';
 let liked = new Set();
 try { const a = JSON.parse(localStorage.getItem(key)||'[]'); if(Array.isArray(a)) liked=new Set(a.filter(v=>typeof v==='string'));} catch (_) {}
 let selectedMood='all', active=0;
 const moods=Array.from(document.querySelectorAll('[data-mood]'));
 function getPool(){const pool=selectedMood==='all'?matches:matches.filter(m=>m.type===selectedMood);return pool.length?pool:matches;}
 function current(){const pool=getPool();return pool[active%pool.length];}
 function renderLiked(){
  const list=Array.from(liked).map(id=>matches.find(m=>m.id===id)).filter(Boolean);
  els.liked.textContent='';
  if(!list.length){const row=document.createElement('li');row.className='no-likes';row.textContent='Tap the heart to save a fitness idea here.';els.liked.append(row);}
  else list.forEach(m=>{
   const row=document.createElement('li');
   const a=document.createElement('a');a.href=m.href;a.textContent=m.title+' ↗';
   const button=document.createElement('button');button.type='button';button.setAttribute('aria-label','Remove '+m.title+' from saved');button.textContent='×';
   button.addEventListener('click',()=>{liked.delete(m.id);persist();renderLiked();});
   row.append(a,button);els.liked.append(row);
  });
  els.clear.hidden=!list.length;
 }
 function persist(){try {localStorage.setItem(key,JSON.stringify(Array.from(liked)));}catch(_){}}
 function render(){
  const pool=getPool();const m=current();
  if(!m)return;
  media.className='match-media '+m.background;
  els.type.textContent=m.label;
  els.glyph.textContent=m.glyph;
  els.vibe.textContent=m.score;
  els.tagline.textContent=m.tagline;
  els.title.textContent=m.title;
  els.subtitle.textContent=m.subtitle;
  els.description.textContent=m.description;
  els.link.href=m.href;
  els.count.textContent=String((active%pool.length)+1).padStart(2,'0')+' / '+String(pool.length).padStart(2,'0');
  els.dots.textContent='';
  pool.forEach((p,i)=>{const dot=document.createElement('span');if(i===active%pool.length)dot.className='on';els.dots.append(dot);});
  const isSaved=liked.has(m.id);
  els.hint.textContent=isSaved?'♥ Saved to your private likes · Keep exploring':'Tap × for next · ♥ to save · or swipe left / right';
  const like=document.getElementById('like-match');
  like.setAttribute('aria-label',isSaved?'Saved fitness match — tap to save again':'Save this fitness match');
 }
 function next(){const pool=getPool();if(!pool.length)return;active=(active+1)%pool.length;render();}
 document.getElementById('pass-match').addEventListener('click',next);
 document.getElementById('like-match').addEventListener('click',()=>{
  const m=current();if(!m)return;
  liked.add(m.id);persist();renderLiked();next();
 });
 els.clear.addEventListener('click',()=>{liked.clear();persist();renderLiked();render();});
 moods.forEach(b=>b.addEventListener('click',()=>{selectedMood=b.dataset.mood||'all';active=0;moods.forEach(btn=>{const on=btn===b;btn.classList.toggle('active',on);btn.setAttribute('aria-pressed',String(on));});render();}));
 let touch=null;
 screen.addEventListener('touchstart',e=>{if(e.touches.length===1)touch={x:e.touches[0].clientX,y:e.touches[0].clientY};},{passive:true});
 screen.addEventListener('touchend',e=>{
  if(!touch||!e.changedTouches.length)return;
  const dx=e.changedTouches[0].clientX-touch.x;
  const dy=e.changedTouches[0].clientY-touch.y;
  touch=null;
  if(Math.abs(dx)<65||Math.abs(dx)<Math.abs(dy)*1.3)return;
  if(dx>0){const m=current();if(m){liked.add(m.id);persist();renderLiked();next();}}
  else next();
 },{passive:true});
 renderLiked();render();
</script>
<style is:global>
:root{--text:#271e2c;--soft:#716473;--pink:#eb427e;--berry:#b62a70;--line:#f0e3ee;--bg:#fff8fb;--font:'DM Sans',Arial,sans-serif;--display:'Outfit','DM Sans',sans-serif}
