---
const year = new Date().getFullYear();
const routes = [
  {eyebrow:'01 / START', title:'New to training?', description:'Find a comfortable starting point with a simple free fitness guide.',href:'/start/',action:'Find my starting plan',mark:'↗',tone:'start'},
  {eyebrow:'02 / TRAIN', title:'Explore workouts', description:'Browse structured four-week example routines for different experience levels.',href:'/programmes/',action:'See free programmes',mark:'↗',tone:'train'},
  {eyebrow:'03 / LEARN', title:'Exercise library', description:'Look up demonstrations for weight training, cardio and HIIT movements.',href:'/app/workouts/',action:'Watch exercise demos',mark:'↗',tone:'learn'}
];
const levels = [
  {index:'01',title:'BEGINNER',tag:'BUILD THE BASICS',description:'Learn the movements, set a manageable routine, and focus on consistency.',href:'/programmes/'},
  {index:'02',title:'INTERMEDIATE',tag:'MAKE PROGRESS',description:'Explore more structure, strength work and balanced training days.',href:'/programmes/'},
  {index:'03',title:'ADVANCED',tag:'TRAIN WITH PURPOSE',description:'Review challenging example routines and refine your approach.',href:'/programmes/'}
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#0d1110"/>
  <meta name="google-site-verification" content="--7gUnBNnZpqeBYDpyAtk7VVAAE0Uvzu4O2QODevqr4"/>
  <meta name="description" content="BF GYM Global means Best Fitness Gym Global. Free workout plans, exercise demonstrations and a device-only workout dashboard from Coach Adeep Aji, a Kerala-born fitness trainer based in the UK. Get started without logging in."/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content="BF GYM Global | Train With Purpose"/>
  <meta property="og:description" content="A professional, approachable fitness learning space. Free workouts, clear exercise guidance and training tools. Start without an account."/>
  <meta property="og:url" content="https://bfgym.netlify.app/"/>
  <meta property="og:image" content="https://bfgym.netlify.app/images/trainer/adeep-instagram.jpg"/>
  <meta property="og:image:alt" content="BF GYM Global founder Coach Adeep Aji"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="canonical" href="https://bfgym.netlify.app/"/>
  <link rel="icon" href="/bf-icon.svg" type="image/svg+xml"/>
  <link rel="manifest" href="/manifest.webmanifest"/>
  <link rel="apple-touch-icon" href="/app-icon-192.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org',
    '@type':'WebSite',
    name:'BF GYM Global',
    alternateName:'Best Fitness Gym Global',
    url:'https://bfgym.netlify.app/',
    description:'Free fitness learning and training resources from a Kerala-born coach based in the United Kingdom.',
    inLanguage:['en','ml'],
    sameAs:['https://www.instagram.com/fitwithaadhi/']
  })}></script>
  <title>BF GYM Global — Best Fitness | Train With Purpose</title>
</head>
<body>
<a href="#main" class="skip">Skip to content</a>
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="logo" aria-label="BF GYM Global home"><span class="logo-mark">BF<span>.</span></span><span class="logo-name">GYM <small>GLOBAL</small></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/start/">Start Here</a>
      <a href="/programmes/">Free Programmes</a>
      <a href="/app/workouts/">Exercise Videos</a>
      <a href="/trainer/">Our Coach</a>
    </nav>
    <a class="header-cta" href="/app/dashboard/">MY DASHBOARD <span aria-hidden="true">↗</span></a>
  </div>
</header>
<nav class="mobile-nav" aria-label="Mobile primary navigation">
 <a href="/" aria-current="page"><span aria-hidden="true">⌂</span><small>Home</small></a>
 <a href="/programmes/"><span aria-hidden="true">▤</span><small>Plans</small></a>
 <a href="/start/" class="mobile-start"><span aria-hidden="true">+</span><small>Start</small></a>
 <a href="/app/workouts/"><span aria-hidden="true">▷</span><small>Videos</small></a>
 <a href="/app/dashboard/"><span aria-hidden="true">◉</span><small>Track</small></a>
</nav>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="signal"></span> BEST FITNESS / GLOBAL FITNESS EDUCATION</div>
        <h1 id="hero-title">TRAIN WITH<br/><span>PURPOSE.</span></h1>
        <p class="hero-lead">Fitness made clear. Find free training plans, learn movements, and build progress at your own pace with BF GYM Global.</p>
        <div class="hero-actions">
          <a href="/start/" class="primary-btn">START TRAINING FREE <span aria-hidden="true">↗</span></a>
          <a href="/programmes/" class="outline-btn">VIEW WORKOUT PLANS <span aria-hidden="true">→</span></a>
        </div>
        <div class="trust-line"><span><b>✓</b> No account needed</span><span><b>✓</b> Free learning</span><span><b>✓</b> All levels</span></div>
      </div>
      <div class="hero-image">
        <img src="/images/trainer/adeep-portrait-new.webp" alt="BF GYM Global founder and trainer Coach Adeep Aji" width="620" height="740" fetchpriority="high"/>
        <div class="image-gradient"></div>
        <div class="image-corner"><span>BF / GLOBAL</span><strong>DISCIPLINE.<br/>CONSISTENCY.<br/>PROGRESS.</strong></div>
        <div class="coach-pill"><span class="pill-light"></span> COACH ADEEP AJI <span>KERALA → UK</span></div>
      </div>
    </div>
    <div class="hero-bg-mark" aria-hidden="true">BF.</div>
  </section>

  <section class="quick-access shell" aria-labelledby="quick-title">
    <div class="section-top"><div><p class="kicker">YOUR FIRST MOVE</p><h2 id="quick-title">WHAT DO YOU WANT TO DO?</h2></div><p class="section-intro">Three clear ways to get started. No complicated sign-up.</p></div>
    <div class="route-grid">
      {routes.map(item=>(
        <a href={item.href} class:list={['route-card',item.tone]}>
          <span class="route-eyebrow">{item.eyebrow}</span>
          <span class="route-symbol" aria-hidden="true">{item.mark}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="route-action">{item.action}<span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="levels-section" aria-labelledby="levels-title">
    <div class="shell">
      <div class="section-top levels-top"><div><p class="kicker">FREE FOUR-WEEK EXAMPLES</p><h2 id="levels-title">FIND YOUR LEVEL.</h2></div><p class="section-intro">Start where you are. Progress is built one session at a time.</p></div>
      <div class="levels-grid">
        {levels.map(level=>(
          <a class="level" href={level.href} aria-label={'Explore '+level.title.toLowerCase()+' workouts'}>
            <div class="level-top"><span>{level.index} / 03</span><span class="level-arrow" aria-hidden="true">↗</span></div>
            <div class="level-content"><span>{level.tag}</span><h3>{level.title}</h3><p>{level.description}</p></div>
          </a>
        ))}
      </div>
      <div class="levels-foot"><span>BEGINNER FRIENDLY · SELF-PACED · FREE</span><a href="/programmes/">EXPLORE ALL TRAINING PLANS <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="tools-section shell" aria-labelledby="tools-title">
    <div class="tools-main"><p class="kicker">MAKE EACH SESSION COUNT</p><h2 id="tools-title">YOUR FITNESS.<br/><span>YOUR PACE.</span></h2><p>Keep a simple record of your workouts using the BF GYM dashboard. Your completed-session history stays on this device, not in a public profile.</p><a href="/app/dashboard/" class="primary-btn">OPEN WORKOUT TRACKER <span aria-hidden="true">↗</span></a></div>
    <div class="tools-side">
      <div class="tool-tile"><span class="tool-index">01 / VIDEO LIBRARY</span><h3>LEARN THE MOVEMENT.</h3><p>Find exercise demonstrations before your next workout.</p><a href="/app/workouts/">EXPLORE VIDEO DEMOS <span aria-hidden="true">↗</span></a></div>
      <div class="tool-tile"><span class="tool-index">02 / SAMPLE PLAN</span><h3>START WITH A SIMPLE ROUTINE.</h3><p>See an example of a balanced workout and eating plan.</p><a href="/sample-plan/">VIEW THE SAMPLE <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="coach-section" aria-labelledby="coach-title">
    <div class="shell coach-grid">
      <div class="coach-visual"><img src="/images/trainer/adeep-portrait-new.webp" alt="Coach Adeep Aji, BF GYM Global founder" width="520" height="530" loading="lazy"/><span>MEET YOUR COACH / 001</span></div>
      <div class="coach-copy"><p class="kicker">THE PERSON BEHIND BEST FITNESS</p><h2 id="coach-title">MEET<br/>COACH ADEEP.</h2><p>I'm Adeep Aji, a Malayali fitness trainer from Kerala, now based in the UK. BF GYM Global is my space for making fitness education simpler, more approachable and useful for everyone.</p><p class="coach-detail">Kerala roots. A global vision. Training that fits real life.</p><div class="coach-actions"><a class="primary-btn" href="/trainer/">ABOUT THE COACH <span aria-hidden="true">↗</span></a><a href="/ml/kerala-uk/" lang="ml" class="coach-language">മലയാളത്തിൽ വായിക്കാം ↗</a></div></div>
    </div>
  </section>

  <section class="card-section shell" aria-labelledby="card-title">
    <div class="card-inner"><div><p class="kicker">A LITTLE SOMETHING EXTRA</p><h2 id="card-title">MAKE YOUR BF CARD.</h2><p>Want to make it personal? Create a private card preview with a nickname, fitness interest and optional Instagram username. It's a preview stored on your device — not an active membership or online registration.</p><a href="/join/" class="card-btn">TRY THE CARD PREVIEW <span aria-hidden="true">↗</span></a></div><div class="card-example" aria-label="Fictional membership card sample"><div class="card-example-top"><strong>BF<span>.</span> GYM</strong><small>DEMO ONLY</small></div><div class="card-example-middle"><span>YOUR FITNESS STARTS HERE</span><strong>BEST FITNESS</strong></div><div class="card-example-bottom">PRIVATE PREVIEW <span>GLOBAL / BF</span></div></div></div>
  </section>
</main>

<footer class="footer">
 <div class="shell footer-grid"><div class="footer-brand"><a href="/" class="logo"><span class="logo-mark">BF<span>.</span></span><span class="logo-name">GYM <small>GLOBAL</small></span></a><p>BEST FITNESS. GLOBAL VISION.</p><span class="footer-small">Free fitness learning from the UK, open to the world.</span></div><div class="footer-links"><h2>EXPLORE</h2><a href="/start/">Get started</a><a href="/programmes/">Workout plans</a><a href="/app/workouts/">Exercise videos</a><a href="/app/dashboard/">My dashboard</a></div><div class="footer-links"><h2>BF GYM</h2><a href="/trainer/">Meet Coach Adeep</a><a href="/kerala-uk/">Our Kerala → UK story</a><a href="/join/">Private BF card demo</a><a href="/privacy/">Privacy information</a></div><div class="footer-links"><h2>FOLLOW</h2><a href="https://www.instagram.com/fitwithaadhi/" target="_blank" rel="noopener noreferrer">Instagram @fitwithaadhi ↗</a><a href="/ml/kerala-uk/" lang="ml">മലയാളം ↗</a></div></div>
 <div class="shell footer-bottom"><span>© {year} BF GYM Global. All rights reserved.</span><span>Paid coaching, real membership accounts and bookings are not active. Free tools are educational.</span></div>
</footer>

<style is:global>
:root{--bg:#0d1110;--surface:#171d19;--panel:#212922;--lime:#c7fa51;--text:#f4f6ef;--muted:#b2bbb0;--line:#323c34;--body:'DM Sans',Arial,sans-serif;--display:'Oswald',Impact,Arial,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.65 var(--body);-webkit-font-smoothing:antialiased}a{text-decoration:none;color:inherit}img{max-width:100%}a:focus-visible{outline:3px solid var(--lime);outline-offset:4px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:var(--display)}.shell{width:min(1240px,calc(100% - 52px));margin-inline:auto}.skip{position:fixed;top:-100px;left:12px;background:var(--lime);color:#122013;z-index:500;padding:10px 18px;font-weight:800}.skip:focus{top:10px}.kicker{color:var(--lime);font-size:11px;font-weight:900;letter-spacing:.15em;margin:0 0 12px}
.site-header{position:sticky;top:0;z-index:90;background:#101611f5;border-bottom:1px solid #354135;backdrop-filter:blur(14px)}.header-inner{min-height:77px;display:flex;gap:25px;justify-content:space-between;align-items:center}.logo{display:flex;align-items:center;gap:9px;white-space:nowrap}.logo-mark{font:700 35px/1 var(--display);letter-spacing:-.05em}.logo-mark span{color:var(--lime)}.logo-name{font:700 25px/1 var(--display);letter-spacing:.02em}.logo-name small{font:800 9px var(--body);color:var(--lime);letter-spacing:.16em;vertical-align:middle}.desktop-nav{display:flex;align-items:center;gap:27px}.desktop-nav a{font-size:12px;font-weight:800;color:#d7e0d4}.desktop-nav a:hover,.footer-links a:hover{color:var(--lime)}.header-cta{white-space:nowrap;border:1px solid #819c6b;border-radius:4px;color:var(--lime);padding:12px 16px;font-size:11px;font-weight:900;letter-spacing:.04em}.header-cta span{margin-left:7px}
.hero{position:relative;overflow:hidden;background:radial-gradient(circle at 75% 55%,#283c25 0%,transparent 44%),#0e1310}.hero-grid{min-height:610px;display:grid;grid-template-columns:1.07fr .93fr;align-items:center;gap:35px;position:relative;z-index:1}.hero-copy{padding:70px 0}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--lime);font-size:10px;letter-spacing:.15em;font-weight:900}.signal{height:9px;width:9px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px #c7fa5130}.hero h1{font:700 clamp(80px,9.2vw,136px)/.96 var(--display);letter-spacing:-.025em;margin:26px 0 25px}.hero h1 span{color:var(--lime)}.hero-lead{max-width:560px;color:#c3cfc0;font-size:17px;line-height:1.8;margin-bottom:28px}.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.primary-btn,.outline-btn,.card-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;min-height:49px;padding:13px 19px;font-size:11px;font-weight:900;letter-spacing:.04em;border-radius:3px}.primary-btn{color:#182110;background:var(--lime)}.primary-btn:hover,.card-btn:hover{background:#dafb8b}.outline-btn{color:#eaf4e5;border:1px solid #80917d}.outline-btn:hover{background:#1f2d20}.trust-line{margin-top:30px;display:flex;flex-wrap:wrap;gap:20px;color:#aab9a8;font-size:11px;font-weight:800}.trust-line b{color:var(--lime);margin-right:4px}.hero-bg-mark{position:absolute;font:700 290px var(--display);right:-25px;bottom:-100px;color:#d2f7970a;pointer-events:none}.hero-image{height:600px;align-self:end;position:relative;overflow:hidden;min-width:0;background:linear-gradient(140deg,#879b70,#314031)}.hero-image>img{height:100%;width:100%;object-fit:cover;object-position:50% 18%}.image-gradient{position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#0c1712de)}.image-corner{position:absolute;left:24px;bottom:65px;display:grid;gap:9px}.image-corner span{font-size:10px;letter-spacing:.15em;font-weight:900;color:var(--lime)}.image-corner strong{font:700 36px/1.05 var(--display);letter-spacing:.02em}.coach-pill{position:absolute;left:0;bottom:0;right:0;padding:14px 24px;display:flex;align-items:center;gap:10px;background:#bff350;color:#1b2a18;font-size:10px;font-weight:900;letter-spacing:.07em}.coach-pill>span:last-child{margin-left:auto}.pill-light{height:8px;width:8px;background:#1c3215;border-radius:50%}
.section-top{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:23px}.section-top h2{font-size:clamp(36px,4.5vw,56px);line-height:1.1;margin:0}.section-intro{max-width:285px;font-size:12px;color:#b6c3b2;margin:0}.quick-access{padding-top:87px;padding-bottom:95px}.route-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.route-card{position:relative;display:flex;flex-direction:column;padding:28px;min-height:268px;background:#1a211b;border:1px solid #3a4539;transition:transform .2s,border-color .2s}.route-card:hover{transform:translateY(-4px);border-color:#a7d76d}.route-eyebrow{font-size:10px;font-weight:900;letter-spacing:.12em;color:var(--lime)}.route-symbol{position:absolute;right:25px;top:22px;font:700 35px var(--display);color:#99bd7e}.route-card h3{font-size:32px;line-height:1.05;margin:55px 0 10px;text-transform:uppercase}.route-card p{font-size:12px;color:#b6c3b3;max-width:330px;line-height:1.7}.route-action{margin-top:auto;display:flex;justify-content:space-between;gap:8px;padding-top:17px;border-top:1px solid #455342;color:var(--lime);font-size:11px;font-weight:900}.route-card.train{background:linear-gradient(145deg,#252e20,#1c231b)}.route-card.learn{background:linear-gradient(145deg,#242d27,#171f1a)}
.levels-section{background:#e9efe3;color:#1a2618;padding:83px 0 78px}.levels-section .kicker{color:#57713f}.levels-section .section-intro{color:#586956}.levels-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.level{min-height:344px;background:#152016;color:#fff;padding:23px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.level:nth-child(2){background:#30482e}.level:nth-child(3){background:#4e6043}.level:after{content:'';position:absolute;width:245px;height:245px;border:38px solid #ffffff14;border-radius:50%;right:-100px;top:60px;pointer-events:none}.level-top{display:flex;align-items:center;justify-content:space-between;font-size:10px;font-weight:800;letter-spacing:.1em;color:#e0ead9}.level-arrow{font-size:30px;line-height:1}.level-content{position:relative;z-index:1}.level-content>span{color:var(--lime);font-size:10px;font-weight:900;letter-spacing:.12em}.level h3{font-size:51px;line-height:1;margin:7px 0 15px}.level p{font-size:12px;color:#e3ecdf;max-width:280px}.levels-foot{margin-top:19px;display:flex;justify-content:space-between;align-items:center;gap:20px}.levels-foot>span{font-size:10px;font-weight:900;color:#5a6d51;letter-spacing:.1em}.levels-foot a{font-size:11px;font-weight:900;color:#315427}
.tools-section{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding-top:96px;padding-bottom:98px}.tools-main{background:#1b261b;border:1px solid #344531;padding:39px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.tools-main h2{font-size:clamp(54px,6vw,80px);line-height:1.05;margin:12px 0 18px}.tools-main h2 span{color:var(--lime)}.tools-main p:not(.kicker){color:#bcc9b8;font-size:14px;max-width:430px;line-height:1.8}.tools-main .primary-btn{margin-top:20px}.tools-side{display:grid;gap:17px}.tool-tile{padding:31px;background:#151b16;border:1px solid #374435;display:flex;flex-direction:column;align-items:flex-start}.tool-index{color:var(--lime);font-size:10px;font-weight:900;letter-spacing:.1em}.tool-tile h3{font-size:29px;margin:14px 0 6px;line-height:1.1}.tool-tile p{color:#adbdac;font-size:12px}.tool-tile a{font-size:11px;font-weight:900;color:var(--lime);margin-top:auto;padding-top:16px}
.coach-section{background:#192019;padding:90px 0}.coach-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:9%;align-items:center}.coach-visual{position:relative;min-height:460px;background:#dbe0d5;overflow:hidden}.coach-visual img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;object-position:50% 25%}.coach-visual>span{position:absolute;left:0;bottom:0;right:0;background:#c7fa51;color:#1b2a12;padding:14px 21px;font-size:11px;font-weight:900;letter-spacing:.13em}.coach-copy h2{font-size:clamp(66px,7vw,101px);line-height:1;margin:15px 0 20px}.coach-copy>p:not(.kicker){font-size:15px;color:#bfccbb;line-height:1.85;max-width:570px}.coach-copy .coach-detail{color:#d6e6cc!important;font-weight:800}.coach-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:28px}.coach-language{color:var(--lime);font-size:13px;font-weight:900}
.card-section{padding-top:92px;padding-bottom:96px}.card-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding:42px;background:#212a20;border:1px solid #46583d}.card-inner h2{font-size:56px;line-height:1.1;margin:5px 0 15px}.card-inner p:not(.kicker){color:#b9c8b2;font-size:13px;line-height:1.8;max-width:540px}.card-btn{margin-top:15px;background:var(--lime);color:#19240e}.card-example{max-width:350px;min-height:215px;padding:25px;border-radius:17px;box-shadow:0 17px 37px #0006;background:linear-gradient(125deg,#151d15,#476943);transform:rotate(4deg);border:1px solid #c7fa5180;display:flex;flex-direction:column;justify-content:space-between}.card-example-top,.card-example-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px}.card-example-top>strong{font:700 23px var(--display)}.card-example-top>strong span{color:var(--lime)}.card-example-top small,.card-example-bottom{font-size:9px;color:#cad8c3;font-weight:850;letter-spacing:.08em}.card-example-middle span{font-size:9px;color:var(--lime);letter-spacing:.15em;font-weight:900}.card-example-middle strong{display:block;font:700 38px var(--display)}
