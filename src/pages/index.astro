 <div class="feature-grid">{features.map((item,i)=>(
  <div class="feature"><div class="feature-top"><span class="feature-icon">{item.icon}</span><span class="feature-number">0{i+1}</span></div><h3>{item.title}</h3><p>{item.copy}</p></div>
