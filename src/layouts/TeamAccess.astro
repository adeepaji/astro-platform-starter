---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#101510" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/bf-icon.svg" type="image/svg+xml" />
    <title>{title} · BF GYM Global</title>
  </head>
  <body>
    <header><a class="brand" href="/">BF<span>.</span> GYM <small>GLOBAL</small></a></header>
    <main><slot /></main>
    <footer><a href="/#team">Meet the team</a><a href="/privacy/">Privacy</a></footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  html { color-scheme: dark; background: #101510; color: #f2f5ed; font: 100%/1.5 Arial, sans-serif; }
  body { margin: 0 auto; width: min(100% - 2rem, 32rem); }
  header { padding: 2rem 0; }
  a { color: #c7ff52; text-underline-offset: .18em; }
  .brand { color: inherit; font-weight: 900; font-size: 1.75rem; text-decoration: none; }
  .brand span, .brand small { color: #c7ff52; }
  .brand small { font-size: .75rem; letter-spacing: .12em; }
  main { background: #1b221b; border: 1px solid #3b4839; padding: clamp(1.25rem, 6vw, 2.5rem); }
  h1 { font-size: clamp(2rem, 7vw, 2.75rem); line-height: 1.1; margin: 0 0 1rem; }
  p { margin: .75rem 0 1.25rem; color: #c9d2c5; overflow-wrap: anywhere; }
  label { display: block; font-weight: 700; margin-top: 1rem; }
  input { width: 100%; margin: .4rem 0 .25rem; padding: .75rem; border: 1px solid #7f907b; background: #101510; border-radius: .2rem; font: inherit; }
  button { cursor: pointer; font: inherit; }
  button[type=submit], .primary { margin: 1rem 0; background: #c7ff52; color: #172110; font-weight: 700; padding: .7rem 1.25rem; border: 0; border-radius: .2rem; }
  button:disabled { cursor: wait; opacity: .55; }
  .text-button { padding: .5rem 0; background: none; color: #c7ff52; border: 0; text-decoration: underline; text-underline-offset: .18em; }
  :focus-visible { outline: 3px solid #c7ff52; outline-offset: 3px; }
  [hidden], [role=status]:empty { display: none; }
  [role=status] { border-left: 3px solid #c7ff52; padding-left: .75rem; }
  footer { display: flex; gap: 1.5rem; padding: 1.5rem 0; }
</style>
